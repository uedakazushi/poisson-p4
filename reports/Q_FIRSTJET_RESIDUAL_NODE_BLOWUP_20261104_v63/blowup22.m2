N=2*aa^2-287*aa+10914;
H=(10993+0*aa)*u^0*v^0 + (21648+8882*aa)*u^0*v^1 + (28385+17963*aa)*u^0*v^2 + (16095+23121*aa)*u^1*v^0 + (20288+0*aa)*u^1*v^1 + (11072+18175*aa)*u^1*v^2 + (29834+14040*aa)*u^2*v^0 + (10940+13828*aa)*u^2*v^1 + (21403+0*aa)*u^2*v^2;
good=(1_S % gb(ideal(N,H,diff(u,H),diff(v,H)))==0_S);
print("PATCH_00 "|toString good);
