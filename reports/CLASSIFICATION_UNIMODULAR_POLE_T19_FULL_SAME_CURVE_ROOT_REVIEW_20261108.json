  "independent_source": "from pathlib import Path\nimport hashlib,itertools,json,resource,signal,sys,time\nimport sympy as s\nROOT=Path.cwd();sys.path.insert(0,str(ROOT/'code'))\nfrom classification_rank3_mixed_component_review import COLUMNS,jacobi\nOUT=ROOT/'reports/CLASSIFICATION_UNIMODULAR_POLE_T19_FULL_SAME_CURVE_ROOT_REVIEW_20261108.json'\nJOB=ROOT/'research/classification/jobs/unimodular_pole_t19_full_same_curve_root_review.json'\nassert not OUT.exists()\njob=json.loads(JOB.read_text())\nfor f in job['exact_inputs_and_hashes']:\n assert hashlib.sha256((ROOT/f['path']).read_bytes()).hexdigest()==f['sha256'],f['path']\nstart=time.monotonic();resource.setrlimit(resource.RLIMIT_AS,(1024**3,1024**3));signal.alarm(60)\ne=s.symbols('e');a,b,c,d,H=X=s.symbols('a b c d H');h,x,y,z,w=Y=s.symbols('h x y z w')\nr=-e**3;v=2*e**2-e**3\nold=json.loads((ROOT/'reports/MPS_SMOOTHING_COMPLETION_20261103_v62/T19.json').read_text())\nassert old['all_passed'] and old['component_id']=='T19'\nenv={str(q):q for q in s.symbols('x0:5 p0 p1 t0 t1')}\nsub={env['x'+str(i)]:q for i,q in enumerate(X)}\nsub.update({env['p0']:r,env['p1']:v,env['t0']:(r-v)/2,env['t1']:r-v})\nraw=s.zeros(5)\nfor ij,f in old['homogeneous_bivector'].items():\n i,j=map(int,ij.split(','));raw[i,j]=s.cancel(s.sympify(f,locals=env).subs(sub,simultaneous=True));raw[j,i]=-raw[i,j]\nq=s.Matrix([-2*e**3*(b+c),e**4*(a-2*b-4*c),-e*(2*b+c+d),e**2*(a+2*b+2*c),-a+2*b+c+d+H])\nM=q.jacobian(X);Mi=M.inv();assert s.factor(M.det())==4*e**10\ninverse=s.Matrix([h/e**3+z/e**2,x/(2*e**4)-3*h/(2*e**3)-z/(2*e**2),h/e**3-x/(2*e**4)+z/(2*e**2),-y/e+2*h/e**3-x/(2*e**4)+z/(2*e**2),w+y/e+z/e**2+h/e**3])\nassert (Mi*s.Matrix(Y)-inverse).applyfunc(s.expand)==s.zeros(5,1)\nassert (inverse.subs(dict(zip(Y,q)),simultaneous=True)-s.Matrix(X)).applyfunc(s.expand)==s.zeros(5,1)\ndef can(P):\n E=s.Matrix(Y);Z=s.Matrix([s.expand(sum(s.diff(P[i,j],Y[i])for i in range(5)))for j in range(5)])\n return (P-(E*Z.T-Z*E.T)/5).applyfunc(s.expand),Z\ndef coeffs(P):\n polys={ij:s.Poly(P[ij],*Y)for ij in itertools.combinations(range(5),2)}\n return [polys[ij].coeff_monomial(mon)for ij,mon in COLUMNS]\ndef sparse(P):return {ij:{mon:co for mon,co in s.Poly(P[ij],*Y).terms()if co}for ij in itertools.combinations(range(5),2)if P[ij]!=0}\npush=(M*raw.subs(dict(zip(X,inverse)),simultaneous=True)*M.T).applyfunc(s.expand)\nP,Z=can(push);cs=coeffs(P)\nassert len(cs)==150\nfor f in cs:s.Poly(f,e)\nPstar=s.zeros(5)\nfor ij,f in zip(itertools.combinations(range(1,5),2),[h*x,-x*x,x*z-h*h,x*y-h*h,-y*z+h*w-h*y,-x*w+x*y+h*y+h*z]):Pstar[ij]=f;Pstar[ij[::-1]]=-f\ncenter=P.subs(e,0);assert center==can(Pstar)[0]\noldreport=json.loads((ROOT/'reports/CLASSIFICATION_UNIMODULAR_POLE_T19_GRADED_MOMENT_CURVE_20261108.json').read_text())\nassert oldreport['all_exact_checks_passed'] and not oldreport['actual_T19_parent_proved']\nassert oldreport['all_negative_coefficients']==[]\nprev=s.zeros(5)\nfor f,(ij,mon) in zip(oldreport['all150canonical_coefficients'],COLUMNS):\n term=s.sympify(f,locals={'e':e,'R':s.Integer(-1),'V':s.Integer(2)})*s.prod(t**k for t,k in zip(Y,mon));prev[ij]+=term;prev[ij[::-1]]-=term\nS=s.diag(1,1,-1,-1,1)\nafter=(S*prev.subs(dict(zip(Y,S*s.Matrix(Y))),simultaneous=True)*S.T).applyfunc(s.expand)\nassert after==P\nstrict=jacobi(sparse(P));assert all(s.expand(f)==0 for f in strict)\noriginal=jacobi(sparse(P),raw=True);assert all(s.expand(f)==0 for row in original.values()for f in row.values())\npf=0\nfor i in range(5):\n j,k,l,m=[t for t in range(5)if t!=i];pf+=(-1)**i*Y[i]*(P[j,k]*P[l,m]-P[j,l]*P[k,m]+P[j,m]*P[k,l])\npf=s.expand(pf);assert s.expand(pf-4*e**10*(-r*(r-v)*H*(c*d-b*b)*(a*b+d*H)).subs(dict(zip(X,inverse)),simultaneous=True))==0\nassert pf.subs(e,0)==h**5\norder=sorted({tuple(q.count(i)for i in range(5))for q in itertools.combinations_with_replacement(range(5),5)},reverse=True)\nassert len(order)==126\nresult=dict(task_id='E_multiple_hyperplane',status='independent_author_full_same_actual_curve_exact_replay_PASS',all_passed=True,new_point_or_frame_parameter=False,old_direct_span_FALSE_preserved=True,source_periods=list(map(str,[r,v,(r-v)/2,r-v])),period_open=str(s.expand(-r*(r-v))),actual_frame=list(map(str,q)),inverse=list(map(str,inverse)),determinant=str(s.factor(M.det())),all150canonical=list(map(str,cs)),coefficient_order=[dict(pair=list(ij),exponent=list(mon))for ij,mon in COLUMNS],all150_center=list(map(str,coeffs(center))),all_negative_coefficients=[],all350_original_coefficients=['0']*350,strict_projective_Jacobi=True,full126_order=[list(mon)for mon in order],full126_actual_D=list(map(str,[s.Poly(pf,*Y).coeff_monomial(mon)for mon in order])),full_D_center='h**5',full_saved_universal_report_after_sign_equals_independent_reconstruction=True,raw_Euler_field=list(map(str,Z)),whole_Pstar_T19_proved=True,whole_h5_composition='uses prior separately accepted full C6/L24/Q60 plus one-orbit theorem, not reproved highest classification here',inputs=job['exact_inputs_and_hashes'],seconds=time.monotonic()-start,maximum_RSS_KiB=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,independent_source=Path(__file__).read_text())\nsignal.alarm(0)\nwith OUT.open('x')as f:json.dump(result,f,ensure_ascii=False,indent=2);f.write('\\n')\nprint(json.dumps({k:result[k]for k in ['status','seconds','maximum_RSS_KiB','whole_Pstar_T19_proved']},ensure_ascii=False))\n"
}
