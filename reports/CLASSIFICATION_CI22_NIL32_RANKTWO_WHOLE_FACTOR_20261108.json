  "inline_source": "import json,time,resource,hashlib,itertools as it\nfrom pathlib import Path\nfrom fractions import Fraction as Q\nimport sympy as S\nstart=time.perf_counter();resource.setrlimit(resource.RLIMIT_AS,(768*1024**2,)*2);resource.setrlimit(resource.RLIMIT_CPU,(85,86))\npath='reports/CLASSIFICATION_NONNORMAL_CI22_TANGENT_20261107.json';r=json.load(open(path));c=next(c for c in r['cases']if c['model']=='nil32')\nrows=[{int(j):Q(v)for j,v in row.items()}for row in c['full350_Jacobi_rows']]\ndef plus(a,b,m=Q(1)):\n out=dict(a)\n for j,v in b.items():\n  out[j]=out.get(j,Q(0))+m*v\n  if not out[j]:del out[j]\n return out\ndef scale(a,m):return {j:v*m for j,v in a.items()if v*m}\nbasis={};lifts={}\nfor i,row in enumerate(rows):\n a=dict(row);li={i:Q(1)}\n for pivot in sorted(basis):\n  if pivot in a:\n   mult=a[pivot];a=plus(a,basis[pivot],-mult);li=plus(li,lifts[pivot],-mult)\n if not a:continue\n pivot=min(a);mult=a[pivot];a=scale(a,1/mult);li=scale(li,1/mult)\n for p,b in list(basis.items()):\n  if pivot in b:\n   mult=b[pivot];basis[p]=plus(b,a,-mult);lifts[p]=plus(lifts[p],li,-mult)\n basis[pivot]=a;lifts[pivot]=li\nassert len(basis)==17\nsaved=[{int(j):Q(v)for j,v in row.items()}for row in c['full_Jacobi_coefficient_rowspace_basis']]\nsavedlifts=[]\nfor v in saved:\n a=dict(v);li={}\n for pivot in sorted(basis):\n  if pivot in a:\n   mult=a[pivot];a=plus(a,basis[pivot],-mult);li=plus(li,lifts[pivot],mult)\n assert not a\n rec={}\n for i,m in li.items():rec=plus(rec,rows[i],m)\n assert rec==v\n savedlifts.append(li)\nresids=[];flifts=[]\nfor row in c['full126_actualPf_rows']:\n a={int(j):Q(v)for j,v in row.items()};li={}\n for b,bl in zip(saved,savedlifts):\n  pivot=min(b)\n  if pivot in a:\n   mult=a[pivot];a=plus(a,b,-mult);li=plus(li,bl,mult)\n rec=dict(a)\n for i,m in li.items():rec=plus(rec,rows[i],m)\n assert rec=={int(j):Q(v)for j,v in row.items()}\n resids.append(a);flifts.append(li)\nold={v['row']:{int(j):Q(a)for j,a in v['remainder'].items()}for v in c['actual_D_rowspace_nonmembership_residuals']}\nassert all(a==old.get(i,{})for i,a in enumerate(resids))\nx=S.symbols('x0:5');p=S.symbols('p0:12');pp=c['parameter_pair_order'];mons5=sorted([tuple(a.count(i)for i in range(5))for a in it.combinations_with_replacement(range(5),5)],reverse=True)\ndef pe(row):return sum(S.Rational(v.numerator,v.denominator)*p[pp[j][0]]*p[pp[j][1]]for j,v in row.items())\nFres=S.expand(sum(pe(row)*S.prod(y**a for y,a in zip(x,e))for row,e in zip(resids,mons5)))\nfac=S.factor_list(Fres);print('Whole residual actualPf factor:',S.factor(Fres),flush=True)\nprint('Residual rowcount',sum(bool(a)for a in resids),'time',time.perf_counter()-start,flush=True)\nout={'task_id':'E_reduced_nonnormal','all_exact_original_row_lift_checks_passed':True,'source_model':'nil32 full12source','all_saved17_Jacobi_basis_exact_original350_lifts':[{str(i):str(v)for i,v in a.items()}for a in savedlifts],'all126_Pf_original350_lifts':[{str(i):str(v)for i,v in a.items()}for a in flifts],'all126_actualPf_residual_rows':[{str(j):str(v)for j,v in a.items()}for a in resids],'all_residual_rows_equal_old_saved_residuals':True,'parameter_pair_order':pp,'quintic_monomial_order':mons5,'actualPf_residual_formula':str(Fres),'whole_residual_factor_scalar':str(fac[0]),'whole_residual_factors':[{'factor':str(f),'multiplicity':int(m),'spatial_degree':S.Poly(f,*x).total_degree()}for f,m in fac[1]],'input_sha256':{path:hashlib.sha256(Path(path).read_bytes()).hexdigest()},'no_new_Jacobioperator_sourcepoint_GB_minor_jet':True,'seconds':time.perf_counter()-start,'maximum_RSS_KiB':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,'inline_source':Path(__file__).read_text()}\npo=Path('reports/CLASSIFICATION_CI22_NIL32_RANKTWO_WHOLE_FACTOR_20261108.json');assert not po.exists();po.write_text(json.dumps(out,ensure_ascii=False,indent=2)+'\\n')\n"
