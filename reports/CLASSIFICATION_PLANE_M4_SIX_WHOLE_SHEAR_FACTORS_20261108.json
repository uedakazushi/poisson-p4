)\n  if rankS!=6:\n   rec.update(status='UNSUPPORTED_SHEAR_RANK',whole_irreducible_source_empty=False);records.append(rec);print(name,'SHEAR RANK',rankS,'STOP onlythiscase',flush=True);continue\n  free=list(K.T.rref()[1]);C=K[free,:].inv()*S[free,:];Ci=C.inv();assert K*C==S and C*Ci==s.eye(6)\n  gs=s.symbols('s0:6');simult=project(R.plus(R.push(P0,gs),{ij:-p for ij,p in P0.items()}));assert simult[:30,:]==S*s.Matrix(gs)\n  shapes=row.get('all13_leading_shape_weight2_rows',row.get('all_leading_shape_weight2_rows'));assert shapes is not None\n  L=s.Matrix(row['full350_weight2_matrix']+shapes).applyfunc(R.scalar);N=L.nullspace();N=s.Matrix.hstack(*N)if N else s.zeros(9,0)\n  n=N.cols;assert n==row['weight2_fiber_dimension_upper'];assert L*N==s.zeros(L.rows,n)\n  if 'full9_weight2_kernel'in row:\n   old=s.Matrix(row['full9_weight2_kernel']).applyfunc(R.scalar).T;assert old.shape==N.shape and s.Matrix.hstack(old,N).rank()==n\n  pars=s.symbols('t0:'+str(n));coeff=N*s.Matrix(pars)if n else s.zeros(9,1)\n  P=R.plus(P0,{ij:sum(coeff[i]*B2[i][ij]for i in range(9))for ij in H.PAIRS});J=R.jac(P);assert not any(J.values())\n  D=R.actual(P);factor='0'if not D else'u*v'if name=='J0_compression'else'u'if name=='I0_mixed'else'u**2'\n  if D:\n   denom=s.sympify(factor,locals=dict(zip(['a','b','c','u','v'],R.x)));quot,rem=s.div(D,denom,*R.x);assert rem==0 and s.expand(D-denom*quot)==0\n  else:quot=0\n  rec.update(status='WHOLE_SOURCE_ACTUAL_FACTOR_OR_ZERO',kernel_coordinate_rows=free,full_shear_to_K1_matrix=[R.textvec(t)for t in C.tolist()],global_inverse_K1_to_shear=[R.textvec(t)for t in Ci.tolist()],constant_determinant=str(C.det()),all_parameter_complements_retained=True,full9_P2_preserved=True,normalized_affine_P2_forcing_zero_after_actual_shear=True,weight2_complete_matrix_rows=L.rows,weight2_rank=9-n,normalized_P2_kernel_9_by_n=[R.textvec(t)for t in N.tolist()],normalized_P2_parameter_names=list(map(str,pars)),all350_normalized_Jacobi_zero=True,all350_normalized_Jacobi={str(ij):str(z)for ij,z in J.items()},normalized_full_brackets=R.serialize(P),actual_quintic=str(s.factor(D)),proper_factor_or_zero=factor,exact_factor_quotient=str(s.factor(quot)),whole_irreducible_source_empty=True)\n  records.append(rec);print(name,'SHEAR',rankS,'K2',n,'actualD',s.factor(D),flush=True)\nresult=dict(task_id='E_reduced_nonnormal',cases=records,all_six_irreducible_quintic_sources_empty=all(r['whole_irreducible_source_empty']for r in records),all_six_complete_sources_retained=True,scope='Only six previously unresolved fixedconnections from reducedm4 SF special/repeated211; otheralreadycoveredm4 strata unchanged. No newM1, profile or jet; inverse actualsixshears and FULL9P2, actualfullPf.',inputs=contract['exact_inputs_and_hashes'],executed_program=payload['program'],executed_program_sha256=hashlib.sha256(payload['program'].encode()).hexdigest(),seconds=round(time.monotonic()-begun,6),maximum_RSS_KiB=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)\nwith open(OP,'x')as f:json.dump(result,f,indent=2);f.write('\\n')\nprint(json.dumps({k:result[k]for k in('all_six_irreducible_quintic_sources_empty','seconds','maximum_RSS_KiB')}))\n",
