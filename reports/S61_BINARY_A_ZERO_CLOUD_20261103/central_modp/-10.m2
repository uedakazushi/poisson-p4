K0=ideal(q1,q2,q3,q4,q6,q7,q8,q9,q10,q11,q12,q13,q14,q15,q16,q17,q18,q21,q22,q24-5608*q0^1,q25,q26-3841*q0^2,q28,q29,q30,q31,q32,q33,q34,q35,q36,q37,q38,q39,q40,q41,q42,q43,q44,q45,q46-14154*q0^1);
assert isSubset(I,K0);
K1=ideal(q1,q2,q3,q4,q6,q7,q8,q9,q10,q11,q12,q13,q14,q15,q16,q17,q18,q21,q22,q24-13858*q0^1,q25,q26-8960*q0^2,q28,q29,q30,q31,q32,q33,q34-1*q0^1,q35,q36,q37,q38,q39,q40,q41,q42,q43,q44,q45,q46-26617*q0^1);
assert isSubset(I,K1);
K=intersect(K0,K1); G=gb I;
assert isSubset(I,K);
assert all(flatten entries gens K,f->any(1..8,n->f^n%G==0));
print("DIM="|toString dim(R/I));
print("HS="|toString hilbertSeries(R/I,Reduce=>true));
assert(dim(R/I)==1);
print "CENTRAL SUPPORT PASS"; exit 0;
