R=QQ[t,A,B,C,D,F];
Delta=4*C*F-D^2;
I=ideal{(t*(16*C*F - 4*D^2 + t^2)/4),(4*C*t^2),(t*(-16*C*F + 4*D^2 + 8*D*t + 3*t^2)/4),(t^2*(2*D + t)),(-t*(-16*C*F + 4*D^2 - 8*D*t + 3*t^2)/4),(4*F*t^2),(-t^2*(-2*D + t)),(t*(16*C*F - 4*D^2 + 9*t^2)/4),(t^2*(-2*D + 3*t)),(-t^2*(2*D + 3*t)),(4*t^3),(-(-16*A*C*F + 4*A*D^2 - 8*A*D*t + 3*A*t^2 + 16*B*C*t)/4),(-(-16*A*F*t - 16*B*C*F + 4*B*D^2 + 8*B*D*t + 3*B*t^2)/4),(C*(16*C*F - 4*D^2 + t^2)/2),((2*D + t)*(16*C*F - 4*D^2 + t^2)/8),(-(-2*D + t)*(16*C*F - 4*D^2 + t^2)/8),(F*(16*C*F - 4*D^2 + t^2)/2),(A*(16*C*F - 4*D^2 + 9*t^2)/4),(8*C^2*t),(2*C*t*(2*D + t)),(t*(-2*A*D + 3*A*t + 4*B*C)),(-2*C*t*(-2*D + t)),(8*C*F*t),(C*(-16*C*F + 4*D^2 + 8*D*t + 3*t^2)/2),((2*D + t)*(-16*C*F + 4*D^2 + 8*D*t + 3*t^2)/8),(-(-2*D + t)*(-16*C*F + 4*D^2 + 8*D*t + 3*t^2)/8),(F*(-16*C*F + 4*D^2 + 8*D*t + 3*t^2)/2),(-t*(2*D + t)^2/2),(-t*(-2*D + t)*(2*D + t)/2),(2*F*t*(2*D + t)),(B*(16*C*F - 4*D^2 + 9*t^2)/4),(-C*(-16*C*F + 4*D^2 - 8*D*t + 3*t^2)/2),(-(2*D + t)*(-16*C*F + 4*D^2 - 8*D*t + 3*t^2)/8),((-2*D + t)*(-16*C*F + 4*D^2 - 8*D*t + 3*t^2)/8),(-F*(-16*C*F + 4*D^2 - 8*D*t + 3*t^2)/2),(-t*(-4*A*F + 2*B*D + 3*B*t)),(-2*F*t*(-2*D + t)),(8*F^2*t),(t*(-2*D + t)^2/2),(C*(16*C*F - 4*D^2 + 9*t^2)/2),((2*D + t)*(16*C*F - 4*D^2 + 9*t^2)/8),(-(-2*D + t)*(16*C*F - 4*D^2 + 9*t^2)/8),(F*(16*C*F - 4*D^2 + 9*t^2)/2),(-2*C*t*(-2*D + 3*t)),(-t*(-2*D + 3*t)*(2*D + t)/2),(-t*(-2*D + t)*(-2*D + 3*t)/2),(2*F*t*(-2*D + 3*t)),(-2*C*t*(2*D + 3*t)),(-t*(2*D + t)*(2*D + 3*t)/2),(t*(-2*D + t)*(2*D + 3*t)/2),(-2*F*t*(2*D + 3*t)),(-8*C*t^2),(-2*t^2*(2*D + t)),(-2*t^2*(-2*D + t)),(8*F*t^2)};
assert(t^3%gb I==0);
assert(I+ideal(t)==ideal(t,Delta*A,Delta*B,Delta*C,Delta*D,Delta*F));
scan(flatten entries gens I,f->assert(f%gb ideal(t,Delta)==0));
print "CRITICAL_SUPPORT_EXACT_IDEALS_PASS";stdio << flush;exit 0;
