R=QQ[t0,t1,t2,t3,t4,t5,t6,t7,t8];
I=ideal(-64*t0^4*t1/625,64*t0^4*t1/625,4*t0^2/5 - 4*t0*t2/5 - 2*t4,8*t0^3/25 + 8*t0^2*t2/25 - 8*t0*t3/5 + 4*t0*t4/5 - 4*t5,32*t0^3*t1/125,4*t0/5 - 2*t6,8*t0*t6/5 - 4*t7,4*t0*t7/5 - 6*t8,16*t0^2*t1*t4/25,32*t0^2*t1*t5/25,-16*t0^3*t1/125 + 16*t0^2*t1*t2/25,32*t0^2*t1*t3/25,16*t0^2*t1*t6/25,32*t0^2*t1*t7/25,48*t0^2*t1*t8/25,-16*t0^2*t1/25,-8*t0*t1/5,-16*t0^2*t1*t4/25,-16*t0^3*t1/125 - 16*t0^2*t1*t2/25,-32*t0^2*t1*t6/25,-16*t0^2*t1*t7/25,2*t0^2/5 + 2*t0*t2/5 - 2*t3,11*t0/5 - t2,-t0*t4 + t2*t4,2*t0^2*t4/5 + 2*t0*t2*t4/5 - 2*t0*t5 + 2*t2*t5 - 2*t3*t4,-32*t0^4*t1/625,-t0^2/5 - 4*t0*t2/5 + t2^2,-2*t0^3/25 + 8*t0^2*t2/25 + 2*t0*t2^2/5 - 8*t0*t3/5,2*t0^2/5 + 2*t0*t2/5 - t0*t6 + t2*t6 - 2*t3,4*t0^2*t6/5 + 4*t0*t2*t6/5 - 2*t0*t7 + 2*t2*t7 - 4*t3*t6,2*t0^2*t7/5 + 2*t0*t2*t7/5 - 3*t0*t8 + 3*t2*t8 - 2*t3*t7,-16*t0^3*t1/125,16*t0^3*t1*t4/125,32*t0^3*t1*t5/125,6*t0^2*t1/25 + 2*t0*t1*t2/5 - 2*t1*t3,-16*t0^4*t1/625 + 16*t0^3*t1*t2/125,32*t0^3*t1*t3/125,16*t0^3*t1*t6/125,32*t0^3*t1*t7/125,48*t0^3*t1*t8/125,-16*t0^3*t1*t4/125,-3*t0*t1/5 + t1*t2,-16*t0^4*t1/625 - 16*t0^3*t1*t2/125,-32*t0^3*t1*t6/125,-16*t0^3*t1*t7/125,16*t0^3*t1/125 + 4*t0*t1*t4/5 - 4*t1*t5,12*t0^2*t1/25 + 4*t0*t1*t2/5 - 4*t1*t3,16*t0^4*t1/625 - 16*t0^3*t1*t2/125 - 16*t0^2*t1*t4/25 + 8*t0*t1*t6/5 - 4*t1*t7,-32*t0^3*t1*t3/125 - 32*t0^2*t1*t5/25 + 8*t0*t1*t7/5 - 12*t1*t8,32*t0^2*t1/25 + 2*t1*t4,2*t0*t1/5 + 2*t1*t2,-8*t0*t1/5 + 4*t1*t6,16*t0^4*t1/625 + 16*t0^3*t1*t2/125 + 16*t0^2*t1*t4/25 - 8*t0*t1*t6/5 + 4*t1*t7,3*t0^2/5 - 8*t0*t2/5 + t2^2 - 2*t4,3*t0^3/25 + 8*t0^2*t2/25 + t0*t2^2/5 - 8*t0*t3/5 + 2*t0*t4/5 - 2*t5,4*t0*t1/5,-2*t1*t4,4*t0*t1*t4/5 - 4*t1*t5,32*t0^3*t1^2/125,12*t0*t1/5 - 4*t1*t2,24*t0^2*t1/25 + 8*t0*t1*t2/5 - 8*t1*t3,4*t0*t1/5 - 2*t1*t6,8*t0*t1*t6/5 - 4*t1*t7,4*t0*t1*t7/5 - 6*t1*t8);
J=ideal(t0 - 5*t6/2,t2 - 11*t6/2,t3,t4,t5,t7,t8,t1*t6,t6^2);
assert(I==J);
S=QQ[w,v];
K=ideal(w*v,v^2);
assert(K==intersect(ideal(v),ideal(w,v^2)));
assert(dim(S/K)==1);
assert(degree(S/K)==1);
print hilbertSeries(S/K,Reduce=>true);
print "N_B18_FULL_CRITICAL_GERM_PASS";
exit 0;
