  "inline_source": "from pathlib import Path\nfrom itertools import combinations\nimport json,hashlib,resource,signal,time\nimport sympy as s\nroot=Path('.');begun=time.monotonic();signal.alarm(90);resource.setrlimit(resource.RLIMIT_AS,(1536*1024**2,)*2)\njobpath=root/'research/classification/jobs/cubic_cone_rank_two_four_critical_sources.json';job=json.loads(jobpath.read_bytes())\nfor r in job['exact_inputs_and_hashes']:assert hashlib.sha256((root/r['path']).read_bytes()).hexdigest()==r['sha256'],r['path']\nsource=json.loads((root/'reports/CLASSIFICATION_CUBIC_SURFACE_TANGENT_TWISTED_CUBIC_CONE_03_20261107.json').read_bytes())['linear']['complete_source_basis']\nstructure=json.loads((root/'reports/CLASSIFICATION_CUBIC_CONE_RANK_TWO_BASE_VERTEX_20261107.json').read_bytes())\nmodules=json.loads((root/'reports/CLASSIFICATION_CUBIC_CONE_RANK_TWO_FIVE_MODULES_20261107.json').read_bytes())\nx=s.symbols('x0:5');lam=s.Symbol('lam');env={str(t):t for t in (*x,lam)};pairs=list(combinations(range(5),2))\nbases=[]\nfor b in source:\n P=s.zeros(5)\n for key,text in b.items():\n  import ast\n  i,j=ast.literal_eval(key);P[i,j]=s.sympify(text,locals=env);P[j,i]=-P[i,j]\n bases.append(P)\nassert len(bases)==27\nrecords=[]\nfor label,value in [('A_ss',s.Rational(2,5)),('A_ss',s.Rational(3,5)),('A_nil',s.Rational(2,5)),('A_nil',s.Rational(3,5))]:\n row=next(r for r in modules['records']if r['case']==label)\n wall=next(w for w in row['walls']if s.Rational(w['wall']['root_field_generator'])==value)\n assert wall['full_kernel_dimension']==6\n K=s.Matrix([[s.sympify(c,locals=env)for c in r]for r in wall['complete_kernel']]);assert K.shape==(18,6) and not any(lam in t.free_symbols for t in K)\n k=s.symbols('k0:6');v=K*s.Matrix(k);t=[s.sympify(c,locals=env).subs(lam,value)for c in row['canonical_original_t']]\n coefficients=[s.Integer(0)]*27\n for i,c in zip(structure['base_source_indices'],t):coefficients[i]=c\n for i,c in zip(structure['vertex_source_indices'],v):coefficients[i]=c\n P=s.zeros(5)\n for a,c in zip(bases,coefficients):P+=a*c\n P=P.applyfunc(s.expand)\n assert all(s.expand(sum(s.diff(P[i,j],x[i])for i in range(5)))==0 for j in range(5))\n strict={tri:s.expand(sum(P[i,l]*s.diff(P[j,m],x[l])+P[j,l]*s.diff(P[m,i],x[l])+P[m,l]*s.diff(P[i,j],x[l])for l in range(5)))for tri in combinations(range(5),3)for i,j,m in [tri]}\n allJ=[s.expand(sum((-1)**i*x[q[i]]*strict[q[:i]+q[i+1:]]for i in range(4)))for q in combinations(range(5),4)]\n assert not any(allJ)\n actual=s.expand(sum((-1)**i*x[i]*(P[a,b]*P[c,d]-P[a,c]*P[b,d]+P[a,d]*P[b,c])for i in range(5)for a,b,c,d in [[j for j in range(5)if j!=i]]))\n saved=[]\n for f,rr in zip(row['actualD_particular_coefficients'],row['actualD_vertex_matrix']):\n  saved.append(s.expand(s.sympify(f,locals=env).subs(lam,value)+sum(s.sympify(c,locals=env).subs(lam,value)*q for c,q in zip(rr,v))))\n original=s.expand(sum(s.prod(z**e for z,e in zip(x,ex))*co for ex,co in zip(structure['actualD_spatial_monomials'],saved)))\n assert actual==original\n const=s.Integer(0);factors=[]\n if actual:\n  const,ff=s.factor_list(actual)\n  assert s.expand(const*s.prod(f**m for f,m in ff)-actual)==0\n  factors=[{'factor':str(f),'multiplicity':m,'physical_degree':s.Poly(f,*x).total_degree()}for f,m in ff]\n proper=not actual or sum(f['multiplicity']for f in factors if f['physical_degree'])>=2\n record={'case':label,'lambda':str(value),'all6_vertex_parameters':list(map(str,k)),\n  'canonical_base9':list(map(str,t)),'full18_vertex_kernel':[[str(c)for c in r]for r in K.tolist()],\n  'all27_original_source_coefficients':list(map(str,coefficients)),\n  'all_actual_brackets':{str((i,j)):str(P[i,j])for i,j in pairs},\n  'all_full350_projective_Jacobi_zero':True,'all_canonical_divergence_zero':True,\n  'all126_actualPf_coefficients_match_saved_original_source':True,'actual_signed_Euler_Pfaffian':str(actual),\n  'all126_actualD_coefficients_sparse':{','.join(map(str,ex)):str(c)for ex,c in s.Poly(actual,*x).terms()if c},\n  'factor_coefficient':str(const),'full_polynomial_factors':factors,'exact_factor_product_identity':True,\n  'actualD_zero':not actual,'whole_source_irreduciblequintic_empty_by_factor':bool(proper),\n  'unfactored_quintic_not_claimed_absolutely_irreducible':True,'known_parent_claimed_from_this_computation':False,\n  'scope':'Whole saved6kernel image, allparameterzeros, no M1/operator/rank/minor/points. Positivephysicalfactors retainpositive degree exceptzero; no converseirreducibility from symbolicfactorlist.'}\n records.append(record);print(label,str(value),'degrees',[(f['physical_degree'],f['multiplicity'])for f in factors],'targetempty',bool(proper),flush=True)\nreport={'task_id':'E_reduced_nonnormal','all_exact_checks_passed':True,'cases':records,\n 'finite_scope':'Only four alreadyexisting jumpedA modules, fullsixkernels; no new module orlambda roots generated. Pure B/W andgenericA reduction separately handproved andneedsindependentacceptance.',\n 'whole_four_Acritical_sources_empty_by_factor':all(r['whole_source_irreduciblequintic_empty_by_factor']for r in records),\n 'all_ranktwo_cone_E_completed':False,'new_component_count':0,'input_bindings':job['exact_inputs_and_hashes'],\n 'inline_source':job['inline_source'],'inline_source_sha256':job['inline_source_sha256'],'seconds':time.monotonic()-begun,'maximum_RSS_KiB':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}\np=root/'reports/CLASSIFICATION_CUBIC_CONE_RANK_TWO_FOUR_CRITICAL_SOURCES_20261108.json'\nwith p.open('x')as f:json.dump(report,f,ensure_ascii=False,indent=2);f.write('\\n')\nprint(json.dumps({'all_exact_checks_passed':True,'whole_four_empty':report['whole_four_Acritical_sources_empty_by_factor'],'seconds':report['seconds'],'maximum_RSS_KiB':report['maximum_RSS_KiB']}))\n",
