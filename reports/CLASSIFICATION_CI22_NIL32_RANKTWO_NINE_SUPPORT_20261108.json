  "inline_source": "from pathlib import Path\nimport json,time,resource,hashlib,itertools as it\nimport sympy as S\nbeg=time.perf_counter();resource.setrlimit(resource.RLIMIT_AS,(768*1024**2,)*2);resource.setrlimit(resource.RLIMIT_CPU,(80,81))\npath='reports/CLASSIFICATION_NONNORMAL_CI22_TANGENT_20261107.json';suppath='reports/CLASSIFICATION_NONNORMAL_CI22_SUPPORT_COMPLETION_20261107.json';src=json.load(open(path));sup=json.load(open(suppath));c=next(c for c in src['cases']if c['model']=='nil32')\nx=S.symbols('x0:5');p=S.symbols('p0:12');AA,BB,GG,ZZ,HH,FF=S.symbols('A B G Z H F');loc=dict(zip(map(str,p),p));loc.update(dict(zip(('A','B','G','Z','H','F'),(AA,BB,GG,ZZ,HH,FF))))\npp=c['parameter_pair_order'];mons5=sorted([tuple(a.count(i)for i in range(5))for a in it.combinations_with_replacement(range(5),5)],reverse=True)\nev=lambda row,sub:S.factor(sum(S.Rational(v)*sub[p[i]]*sub[p[j]]for col,v in row.items()for i,j in[pp[int(col)]]))\nrecords=[]\nfor cm in sup['nil32_complete_branch_cover_maps']:\n sub={p[i]:S.sympify(cm['parameter_map'][str(p[i])],locals=loc)for i in range(12)}\n correction=None\n if cm['case']=='p10_nonzero':\n  correction=-(192*AA**2*BB*ZZ+160*AA*BB**2*GG+11*BB**4)/(384*AA**3)\n  sub={v:S.factor(a.subs(HH,correction))for v,a in sub.items()}\n J=[ev(row,sub)for row in c['full350_Jacobi_rows']];assert all(a==0 for a in J),cm['case']\n vals=[ev(row,sub)for row in c['full126_actualPf_rows']]\n F=S.factor(sum(a*S.prod(y**d for y,d in zip(x,e))for a,e in zip(vals,mons5)))\n fac=S.factor_list(F,*x)\n factors=[{'factor':str(a),'multiplicity':int(m),'space_degree':S.Poly(a,*x).total_degree()}for a,m in fac[1]]\n rec={'case':cm['case'],'inverted':cm['inverted'],'full_parameter_map_after_exact_compatibility':{str(a):str(b)for a,b in sub.items()},'old_supersource_single_compatibility_solved_H':None if correction is None else str(correction),'all_original350_Jacobi_zero':True,'actual_quintic_factored':str(F),'factorization_scalar':str(fac[0]),'spatial_factors':factors,'actual_rank4_irreducible_quintic_impossible_by_factor':F==0 or sum(a['multiplicity']for a in factors)>1}\n records.append(rec);print(cm['case'],'F=',F,flush=True)\nr={'task_id':'E_reduced_nonnormal','all_exact_wholemap_checks_passed':True,'coordinate_model':'nil32 full12source q1=2x0x2+x1²+2x3x4,q2=2x1x2+x4²','cases':records,'all_nine_irreducible_quintic_sources_closed':all(a['actual_rank4_irreducible_quintic_impossible_by_factor']for a in records),'source_maps_are_prior_separately_reviewed_full_inverse_cover':True,'first_open_H_elimination_introduces_no_new_unit_beyond_A':True,'other8_original_maps_already_fullPoisson':True,'global_rowspace_only_residual_had_no_simple_factor':'separate immutable wholefactor report; not treated as positive','input_sha256':{p:hashlib.sha256(Path(p).read_bytes()).hexdigest()for p in[path,suppath]},'inline_source':Path(__file__).read_text(),'seconds':time.perf_counter()-beg,'maximum_RSS_KiB':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}\nout=Path('reports/CLASSIFICATION_CI22_NIL32_RANKTWO_NINE_SUPPORT_20261108.json');assert not out.exists();out.write_text(json.dumps(r,ensure_ascii=False,indent=2)+'\\n')\nprint('allclosed',r['all_nine_irreducible_quintic_sources_closed'],'seconds',r['seconds'],'RSS',r['maximum_RSS_KiB'])\n",
