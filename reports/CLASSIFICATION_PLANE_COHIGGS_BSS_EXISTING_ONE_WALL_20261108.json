  "inline_caller_source": "import sys,json,hashlib,resource,time\nfrom pathlib import Path\nfrom fractions import Fraction as F\nsys.path.insert(0,str(Path.cwd()/'code'))\nimport classification_plane_cohiggs_kernel_pointwise as c\nROOT=Path.cwd()\nJOB='research/classification/jobs/plane_cohiggs_bss_existing_one_wall.json'\nOUTPUT='reports/CLASSIFICATION_PLANE_COHIGGS_BSS_EXISTING_ONE_WALL_20261108.json'\nresource.setrlimit(resource.RLIMIT_CPU,(85,90))\nresource.setrlimit(resource.RLIMIT_AS,(1024**3,1024**3))\nstarted=time.monotonic()\njob=json.loads((ROOT/JOB).read_text())\nfor x in job['exact_inputs_and_hashes']:\n    assert hashlib.sha256((ROOT/x['path']).read_bytes()).hexdigest()==x['sha256']\npacket=json.loads((ROOT/'reports/CLASSIFICATION_PLANE_RANK_ZERO_RANK_TWO_NONKERNEL_WEIGHTS_20261107.json').read_text())\nold=next(x for x in packet['cases'] if x['type']=='BSS')\nline=next(x for x in old['analysis']['all_exceptional_lines'] if x['equation']=='2*tau + 3')\nassert line['parameterization']=={'tau':'-3/2','eta':'tau'}\nwall=next(x for x in line['analysis']['all_exceptional_roots'] if x['parameter']=='-10/3')\nassert not wall['excluded_multiplicity_higher']\ndef bind(x):\n    if isinstance(x,str):return x.replace('eta','(-10/3)')\n    if isinstance(x,list):return [bind(v) for v in x]\n    if isinstance(x,dict):return {k:bind(v) for k,v in x.items()}\n    return x\nrecord=bind({k:old[k] for k in ['type','normal_form_P0','complete_D2_350_by9','complete_actual_shear_30_by6']})\nrecord['type']='BSS_original_tau_minus_three_halves_eta_minus_ten_thirds'\nfirst,second=c.bases()\nresult=c.run_case(record,F(-3,2),wall,first,second)\nout=ROOT/OUTPUT;assert not out.exists()\ndata={'task_id':'E_reduced_nonnormal','status':'ONE_existing_whole_BSS_wall_batch_completed',\n      'old_exact_source_location':'cases[BSS].analysis.all_exceptional_lines[2*tau+3].analysis.all_exceptional_roots[parameter=-10/3]',\n      'source_parameters':{'tau':'-3/2','eta':'-10/3'},'all_explicit_identity_checks_passed':True,\n      'whole_source_result':result,'no_new_operator_rank_minor_point_or_jet':True,\n      'seconds':time.monotonic()-started,'maximum_RSS_KiB':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,\n      'inputs':job['exact_inputs_and_hashes'],'inline_caller_source':job['inline_caller_source'],\n      'inline_caller_source_sha256':hashlib.sha256(job['inline_caller_source'].encode()).hexdigest(),\n      'main_frontier_global_oldcode_oldreports_unchanged':True}\nout.write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\\n')\nprint(result['whole_source_conclusion'],result['reduced_support_obstruction_if_any'],flush=True)\nprint('PASS explicit identities',data['seconds'],data['maximum_RSS_KiB'],flush=True)\n",
