  "inline_program": "import sys\nsys.path.insert(0,'code')\nfrom classification_minimal_quartic_review import LaurentRing, determinant\nfrom pathlib import Path\nfrom fractions import Fraction as Q\nimport hashlib,itertools,json,resource,signal,time,traceback\nresource.setrlimit(resource.RLIMIT_AS,(768*1024**2,)*2)\nresource.setrlimit(resource.RLIMIT_CPU,(44,45));signal.alarm(45)\nstarted=time.monotonic()\njobpath=Path('research/classification/jobs/two_quadrics_nil22_active_v_t18_confluence.json');job=json.loads(jobpath.read_text())\nfor f in job['exact_inputs_and_hashes']:assert hashlib.sha256(Path(f['path']).read_bytes()).hexdigest()==f['sha256'],f['path']\noutpath=Path(job['output']);assert not outpath.exists(),outpath\nR=LaurentRing(('e','alpha','beta'),('h','x','y','z','w'),invert=('e',))\nparse=R.parse;add=R.add;mul=R.mul;scale=R.scale\ncoords=list(map(R.variable,('h','x','y','z','w')));one=R.constant(1)\naffpairs=list(itertools.combinations(range(1,5),2))\ndef matrix(entries,pairs=affpairs):\n M=[[{} for _ in range(5)] for _ in range(5)]\n for (i,j),p in zip(pairs,entries):M[i][j]=p;M[j][i]=scale(p,-1)\n return M\ndef mm(A,B):return [[add(*(mul(A[i][k],B[k][j]) for k in range(5))) for j in range(5)] for i in range(5)]\ndef transpose(M):return [list(row) for row in zip(*M)]\ndef identity():return [[R.constant(i==j) for j in range(5)] for i in range(5)]\ndef mparse(rows):return [[parse(str(v)) for v in row] for row in rows]\ndef mplus(*Ms):return [[add(*(M[i][j] for M in Ms)) for j in range(5)] for i in range(5)]\ndef mscale(M,c):return [[scale(p,c) for p in row] for row in M]\ndef wedge(V,W):return [[add(mul(V[i],W[j]),scale(mul(V[j],W[i]),-1)) for j in range(5)] for i in range(5)]\ndef substitute(p,values):\n ans={}\n for ex,c in p.items():\n  a={ex[:3]+(0,)*5:c}\n  for i,power in enumerate(ex[3:]):\n   assert power>=0\n   for _ in range(power):a=mul(a,values[i])\n  ans=add(ans,a)\n return ans\ndef linear_values(M):return [add(*(mul(a,x) for a,x in zip(row,coords))) for row in M]\ndef pf4(P,ids):\n a,b,c,d=ids\n return add(mul(P[a][b],P[c][d]),scale(mul(P[a][c],P[b][d]),-1),mul(P[a][d],P[b][c]))\ndef divisor(P,values=coords):return add(*(scale(mul(values[i],pf4(P,[j for j in range(5) if j!=i])),(-1)**i) for i in range(5)))\ndef encode(p):return [[list(ex),str(c)] for ex,c in sorted(p.items())]\ndef encode_mat(M):return [[encode(p) for p in row] for row in M]\ndef equal(A,B,label):assert A==B,label\ntry:\n source=json.loads(Path('reports/MPS_SMOOTHING_COMPLETION_20261103_v62/T18.json').read_text())\n R0=LaurentRing(('p0','p1','t0','t1'),tuple('x'+str(i) for i in range(5)))\n binding=list(map(parse,['2*beta*e**2','-e/2+2*beta*e**2','e/4+beta*e**2','-e/4-beta*e**2']))\n k=parse('1/4+beta*e');d=parse('e/2');nu=parse('e/4+beta*e**2')\n N=mparse([[1,'e**2','e',0,'alpha*e'],[0,0,0,'-e/2',1],[1,'e**2','-e',0,'alpha*e'],[0,0,0,'e/2',1],[1,0,0,0,0]])\n M=mparse([[0,0,0,0,1],['1/(2*e**2)','-alpha/(2*e)','1/(2*e**2)','-alpha/(2*e)','-1/e**2'],['1/(2*e)',0,'-1/(2*e)',0,0],[0,'-1/e',0,'1/e',0],[0,'1/2',0,'1/2',0]])\n I=identity();equal(mm(M,N),I,'actual inverse MN');equal(mm(N,M),I,'actual inverse NM')\n equal(determinant(R,N),parse('-2*e**4'),'frame determinant');equal(determinant(R,M),parse('-1/(2*e**4)'),'actual map determinant')\n src=linear_values(N);A,B,C,D,H=src\n def bind_source(poly):\n  ans={}\n  for ex,c in poly.items():\n   val=R.constant(c)\n   for i,power in enumerate(ex[:4]):\n    assert power>=0\n    for _ in range(power):val=mul(val,binding[i])\n   for i,power in enumerate(ex[4:]):\n    for _ in range(power):val=mul(val,src[i])\n   ans=add(ans,val)\n  return ans\n rawchanged=[[{} for _ in range(5)] for _ in range(5)]\n for key,text in source['homogeneous_bivector'].items():\n  i,j=map(int,key.split(','))\n  if key=='0,2':\n   assert text=='-2*t0*t1*x4**2/(2*p0 - p1)',text\n   poly=mul(nu,mul(H,H))\n   cleared=bind_source(R0.parse('-2*t0*t1*x4**2'))\n   denominator=bind_source(R0.parse('2*p0-p1'))\n   equal(mul(denomi