K=ZZ/32003;a=promote(28920,K);R=K[x0,x1,x2];I=ideal((3*a/4)*x0^1*x2^1+(a/16)*x2^2,(393*a/280)*x0^2+(-3/2)*x0^1*x1^1+(-589*a/140)*x0^1*x2^1+(3*a/4)*x1^2+(106/35)*x1^1*x2^1+(2767*a/4480)*x2^2,(-27/28)*x0^2+(3/7)*x0^1*x2^1+(27*a/56)*x1^1*x2^1+(667/448)*x2^2,(7641*a/560)*x0^2+(-1317*a/70)*x0^1*x2^1+(4281/560)*x1^1*x2^1+(-84041*a/8960)*x2^2,(-51/140)*x0^2+(3*a/4)*x0^1*x1^1+(-713/280)*x0^1*x2^1+(3/4)*x1^2+(-773*a/560)*x1^1*x2^1+(381/2240)*x2^2);assert(dim(R/I)==0);assert(numColumns basis(R/I)==5);print("DIM="|toString dim(R/I));print("HS="|toString hilbertSeries(R/I,Reduce=>true));print("LENGTH="|toString numColumns basis(R/I));print("GB="|toString gens gb I);print "MIXED CUT PASS";exit 0;
