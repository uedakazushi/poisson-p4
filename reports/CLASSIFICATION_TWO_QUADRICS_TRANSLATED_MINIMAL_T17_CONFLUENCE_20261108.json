  "inline_program": "import sys\nsys.path.insert(0,'code')\nfrom classification_minimal_quartic_review import LaurentRing, determinant\nfrom fractions import Fraction as Q\nfrom pathlib import Path\nimport hashlib,itertools,json,resource,signal,time,traceback\nresource.setrlimit(resource.RLIMIT_AS,(768*1024**2,)*2)\nresource.setrlimit(resource.RLIMIT_CPU,(44,45))\nsignal.alarm(45)\nstarted=time.monotonic()\njobpath=Path('research/classification/jobs/two_quadrics_translated_minimal_t17_confluence.json')\njob=json.loads(jobpath.read_text())\nfor f in job['exact_inputs_and_hashes']:\n    assert hashlib.sha256(Path(f['path']).read_bytes()).hexdigest()==f['sha256'],f['path']\noutpath=Path(job['output'])\nassert not outpath.exists(),outpath\nR=LaurentRing(('e','delta','rho','kappa'),('h','x','y','z','w'),invert=('e','delta'))\nparse=R.parse;add=R.add;mul=R.mul;scale=R.scale\none=R.constant(1);coords=[R.variable(v) for v in ('h','x','y','z','w')]\naffpairs=list(itertools.combinations(range(1,5),2))\ndef matrix(entries,pairs=affpairs):\n    M=[[{} for _ in range(5)] for _ in range(5)]\n    for (i,j),p in zip(pairs,entries):M[i][j]=p;M[j][i]=scale(p,-1)\n    return M\ndef mm(A,B):return [[add(*(mul(A[i][k],B[k][j]) for k in range(5))) for j in range(5)] for i in range(5)]\ndef transpose(M):return [list(row) for row in zip(*M)]\ndef identity():return [[R.constant(i==j) for j in range(5)] for i in range(5)]\ndef mparse(rows):return [[parse(str(v)) for v in row] for row in rows]\ndef mplus(*Ms):return [[add(*(M[i][j] for M in Ms)) for j in range(5)] for i in range(5)]\ndef mscale(M,c):return [[scale(p,c) for p in row] for row in M]\ndef wedge(V,W):return [[add(mul(V[i],W[j]),scale(mul(V[j],W[i]),-1)) for j in range(5)] for i in range(5)]\ndef substitute(p,values):\n    ans={}\n    for ex,c in p.items():\n        a={ex[:4]+(0,)*5:c}\n        for i,power in enumerate(ex[4:]):\n            assert power>=0\n            for _ in range(power):a=mul(a,values[i])\n        ans=add(ans,a)\n    return ans\ndef linear_values(M):return [add(*(mul(a,x) for a,x in zip(row,coords))) for row in M]\ndef push(P,M,Mi):\n    vals=linear_values(Mi)\n    changed=[[substitute(p,vals) for p in row] for row in P]\n    return mm(mm(M,changed),transpose(M))\ndef pf4(P,ids):\n    a,b,c,d=ids\n    return add(mul(P[a][b],P[c][d]),scale(mul(P[a][c],P[b][d]),-1),mul(P[a][d],P[b][c]))\ndef divisor(P,values=coords):return add(*(scale(mul(values[i],pf4(P,[j for j in range(5) if j!=i])),(-1)**i) for i in range(5)))\ndef encode(p):return [[list(ex),str(c)] for ex,c in sorted(p.items())]\ndef encode_mat(M):return [[encode(p) for p in row] for row in M]\ndef equal(A,B,label):assert A==B,label\ntry:\n    source=json.loads(Path('reports/MPS_SMOOTHING_COMPLETION_20261103_v62/T17.json').read_text())\n    R0=LaurentRing(('p0','p1','p2','t0','t1'),tuple('x'+str(i) for i in range(5)),invert=('p1',))\n    binding=list(map(parse,['-2*rho*e+e/2+2*kappa*e**2','-e/2','-e/2-2*kappa*e**2','e/2','-delta/(2*e)']))\n    N=mparse([[1,'e','e**2','-e**2*rho/delta',0],[1,'-e','e**2','-e**2*rho/delta',0],[1,0,'2*rho*e',0,'e'],[0,0,0,1,0],[1,0,0,0,0]])\n    # Correct row order: source (A,B,C,D,H), target (h,x,y,z,w).\n    N=mparse([[1,'e**2','e','-e**2*rho/delta',0],[1,'e**2','-e','-e**2*rho/delta',0],[1,0,'2*rho*e',0,'e'],[0,0,0,1,0],[1,0,0,0,0]])\n    M=mparse([[0,0,0,0,1],['1/(2*e**2)','1/(2*e**2)',0,'rho/delta','-1/e**2'],['1/(2*e)','-1/(2*e)',0,0,0],[0,0,0,1,0],['-rho/e','rho/e','1/e',0,'-1/e']])\n    I=identity();equal(mm(M,N),I,'actual inverse MN');equal(mm(N,M),I,'actual inverse NM')\n    detN=determinant(R,N);detM=determinant(R,M)\n    equal(detN,parse('2*e**4'),'frame determinant2e4');equal(detM,parse('1/(2*e**4)'),'actual determinant inverse')\n    src=linear_values(N)\n    def bind_source(p):\n        ans={}\n        for ex,c in p.items():\n            val=R.constant(c)\n            for i,power in enumerate(ex[:5]):\n                base=binding[i]\n                if power<0:base=R.inverse_monomial(base)\n                for _ in range(abs(power)):val=mul(val,base)\n            for i,power in enumerate(ex[5:]):\n                for _ in range(power):val=mul(val,src[i])\n            ans=add(ans,val)\n        return ans\n    rawchanged=[[{} for _ in range(5)] for _ in range(5)]\n    for key,t in source['homogeneous_bivector'].items():\n        i,j=map(int,key.split(','));p=bind_source(R0.parse(t));rawchanged[i][j]=p;rawchanged[j][i]=scale(p,-1)\n    p,u,q,v,alpha,beta=list(map(parse,['-e/2','e/2','-2*rho*e','delta/e**2','kappa*e**2','-e/2-kappa*e**2']))\n    equal(add(alpha,beta),p,'true alpha+beta=p')\n    equal(add(binding[0],binding[2]),q,'true q inverse')\n    equal(binding[2],add(beta,scale(alpha,-1)),'true rho2 inverse')\n    equal(binding[4],mul(p,v),'true tau1=pv')\n    equal(bind_source(R0.parse(source['period_pfaffian_open'])),parse('rho*e**2'),'true period open')\n    A,B,C,D,H=src\n    Lsrc=[{},scale(mul(p,B),-1),scale(mul(alpha,C),-1),scale(mul(beta,D),-1),{}]\n    canonical_src=mplus(rawchanged,mscale(wedge(src,Lsrc),-1))\n    F=add(mul(p,mul(A,B)),mul(u,mul(H,H)));G=add(mul(q,mul(C,D)),mul(v,F))\n    desired_src=matrix([F,mul(alpha,mul(A,C)),mul(beta,mul(A,D)),scale(mul(alpha,mul(B,C)),-1),scale(mul(beta,mul(B,D)),-1),G],list(itertools.combinations(range(4),2)))\n    equal(canonical_src,desired_src,'all150 true coupled helper gauge')\n    Xe='(x-rho*z/delta)';Re=f'(h*{Xe}-y**2/2+e**2*{Xe}**2/2)';Te=f'(h+e**2*{Xe})';Ce='(h+e*(w+2*rho*y))';Le='(1/2+kappa*e)'\n    equal(F,parse(f'-e**3*{Re}'),'full F period cancellation')\n    equal(G,parse(f'-e*(delta*{Re}+2*rho*{Ce}*z)'),'full G coupled cancellation')\n    entries=[f'{Re}/2+(rho/delta)*{Le}*{Te}*z',f'-{Le}*y*z',f'kappa*y*{Ce}+(2*rho**2/delta)*({Ce}-{Le}*{Te})*z',f'-{Le}*{Te}*z',f'kappa*{Te}*{Ce}',f'delta*{Re}+2*rho*({Ce}-{Le}*{Te})*z']\n    target=matrix(list(map(parse,entries)))\n    observed=mm(mm(M,canonical_src),transpose(M))\n    equal(observed,target,'all150 actual whole T17 polyn