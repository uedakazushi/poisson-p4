R=QQ[s0,s1,s2,s3,s4,s5,s6,s7,s8,s9];
I=ideal(-24*s0^2*s1*s2*s7/125,-32*s0^3*s2*s7/125 - 16*s0*s1*s2*s7/25,32*s0^3*s2*s7/125 + 48*s0*s1*s2*s7/25,4*s0^2/5 - 4*s0*s3/5 + 16*s1/5 - 2*s5,4*s0^2*s7/5 + 4*s0*s3*s7/5 - 8*s0*s4/5 + 16*s1*s7/5 + 2*s5*s7 - 4*s6,16*s0^2*s2*s7/25,4*s7^2 - 4*s8,2*s7*s8 - 6*s9,6*s1*s2*s7/5,-16*s0*s1*s2*s7/25 + 8*s0*s2*s5*s7/5,16*s0*s2*s6*s7/5,-8*s0^2*s2*s7/25 + 8*s0*s2*s3*s7/5,16*s0*s2*s4*s7/5,8*s0*s2*s7^2/5,16*s0*s2*s7*s8/5,24*s0*s2*s7*s9/5,-8*s0*s2*s7/5 - 6*s1*s2/5,-8*s0*s2/5,-16*s0*s1*s2*s7/25 - 8*s0*s2*s5*s7/5,-8*s0^2*s2*s7/25 - 8*s0*s2*s3*s7/5,-8*s0*s2*s7/5,-16*s0*s2*s7^2/5,-8*s0*s2*s7*s8/5,s0*s7 + s1 + s3*s7 - 2*s4,5*s0/3 - s3 + 4*s7/3,-16*s0^2*s1*s2*s7/125,-s0*s5 + s3*s5,s0*s5*s7 - 2*s0*s6 + s3*s5*s7 + 2*s3*s6 - 2*s4*s5,-16*s0^3*s2*s7/125 - 16*s0*s1*s2*s7/25,-s0^2/5 - 4*s0*s3/5 - 4*s1/5 + s3^2,-s0^2*s7/5 + 4*s0*s3*s7/5 - 8*s0*s4/5 - 4*s1*s7/5 + s3^2*s7,2*s3*s7 - 2*s4,2*s0*s7^2 - 2*s0*s8 + 2*s3*s7^2 + 2*s3*s8 - 4*s4*s7,s0*s7*s8 - 3*s0*s9 + s3*s7*s8 + 3*s3*s9 - 2*s4*s8,-8*s0^2*s2*s7/25 - 4*s1*s2*s7/5,-16*s0^2*s1*s2*s7/125 + 8*s0^2*s2*s5*s7/25,16*s0^2*s2*s6*s7/25,3*s0*s2*s7/5 + s2*s3*s7 - 2*s2*s4,-8*s0^3*s2*s7/125 + 8*s0^2*s2*s3*s7/25,16*s0^2*s2*s4*s7/25,8*s0^2*s2*s7^2/25,16*s0^2*s2*s7*s8/25,24*s0^2*s2*s7*s9/25,-8*s0^2*s2*s7/25,4*s1*s2/5,-16*s0^2*s1*s2*s7/125 - 8*s0^2*s2*s5*s7/25,-3*s0*s2/5 + s2*s3,-8*s0^3*s2*s7/125 - 8*s0^2*s2*s3*s7/25,-16*s0^2*s2*s7^2/25,-8*s0^2*s2*s7*s8/25,8*s0^2*s2*s7/25 - 4*s1*s2*s7/5 + 2*s2*s5*s7 - 4*s2*s6,6*s0*s2*s7/5 + 2*s2*s3*s7 - 4*s2*s4,8*s0^3*s2*s7/125 - 8*s0^2*s2*s3*s7/25 + 16*s0*s1*s2*s7/25 - 8*s0*s2*s5*s7/5 + 4*s2*s7^2 - 4*s2*s8,-16*s0^2*s2*s4*s7/25 - 16*s0*s2*s6*s7/5 + 4*s2*s7*s8 - 12*s2*s9,16*s0*s2*s7/5 + 4*s1*s2/5 + 2*s2*s5,2*s0*s2/5 + 2*s2*s3,8*s0^3*s2*s7/125 + 8*s0^2*s2*s3*s7/25 + 16*s0*s1*s2*s7/25 + 8*s0*s2*s5*s7/5 - 4*s2*s7^2 + 4*s2*s8,3*s0^2/5 - 8*s0*s3/5 + 12*s1/5 + s3^2 - 2*s5,3*s0^2*s7/10 + 4*s0*s3*s7/5 - 8*s0*s4/5 + 6*s1*s7/5 + s3^2*s7/2 + s5*s7 - 2*s6,2*s2*s7,4*s1*s2/5 - 2*s2*s5,4*s1*s2*s7/5 + 2*s2*s5*s7 - 4*s2*s6,16*s0^2*s2^2*s7/25,12*s0*s2/5 - 4*s2*s3,12*s0*s2*s7/5 + 4*s2*s3*s7 - 8*s2*s4,4*s2*s7^2 - 4*s2*s8,2*s2*s7*s8 - 6*s2*s9);
J=ideal(s0 - 3*s3/5 + 4*s7/5,s1 + 7*s3^2/20 - 7*s7^2/5,7*s3^2/8 + s4 - 3*s7^2/2,3*s3^2/5 + s5 - 12*s7^2/5,s6,-s7^2 + s8,-s7^3/3 + s9,s2*s3 + 2*s2*s7,7*s2*s3 - 6*s2*s7,7*s3^2 + 8*s3*s7 - 12*s7^2,s3^3 + 6*s3^2*s7 + 12*s3*s7^2 + 8*s7^3);
assert(I==J);
S=QQ[w,u,v];
K=ideal(w*u,w*v,u*v,u^3);
assert(K==intersect(ideal(u,v),ideal(u,w),ideal(w,v,u^3)));
assert(dim(S/K)==1);
assert(degree(S/K)==2);
print hilbertSeries(S/K,Reduce=>true);
print "CA_B18_FULL_CRITICAL_GERM_PASS";
exit 0;
