  "inline_caller_source": "import sys,json,hashlib,resource,time\nfrom pathlib import Path\nfrom fractions import Fraction as F\nsys.path.insert(0,str(Path.cwd()/'code'))\nimport classification_plane_cohiggs_kernel_pointwise as c\nROOT=Path.cwd()\nJOB='research/classification/jobs/plane_cohiggs_ndn_existing_whole_source.json'\nOUTPUT='reports/CLASSIFICATION_PLANE_COHIGGS_NDN_EXISTING_WHOLE_SOURCE_20261108.json'\nresource.setrlimit(resource.RLIMIT_CPU,(85,90))\nresource.setrlimit(resource.RLIMIT_AS,(1024**3,1024**3))\nstarted=time.monotonic()\njob=json.loads((ROOT/JOB).read_text())\nfor x in job['exact_inputs_and_hashes']:\n    assert hashlib.sha256((ROOT/x['path']).read_bytes()).hexdigest()==x['sha256']\npacket=json.loads((ROOT/'reports/CLASSIFICATION_PLANE_RANK_ZERO_RANK_TWO_NONKERNEL_WEIGHTS_20261107.json').read_text())\nold=next(x for x in packet['cases'] if x['type']=='NDN')\nassert old['parameters']==[]\nrecord={k:old[k] for k in ['type','normal_form_P0','complete_D2_350_by9','complete_actual_shear_30_by6']}\nfor k in ('D1','D2','actual_shear'):record['generic_'+k]=old['analysis'][k]\nfirst,second=c.bases()\nresult=c.run_case(record,F(0),None,first,second)\nout=ROOT/OUTPUT;assert not out.exists()\ndata={'task_id':'E_reduced_nonnormal','status':'ONE_fixed_original_NDN_whole_source_batch_completed',\n      'exact_original_source_location':'cases[type=NDN], entire seven-dimensional higher kernel, not a new point.',\n      'all_explicit_identity_checks_passed':True,'whole_source_result':result,\n      'no_new_operator_rank_minor_point_or_jet':True,\n      'seconds':time.monotonic()-started,'maximum_RSS_KiB':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,\n      'inputs':job['exact_inputs_and_hashes'],'inline_caller_source':job['inline_caller_source'],\n      'inline_caller_source_sha256':hashlib.sha256(job['inline_caller_source'].encode()).hexdigest(),\n      'main_frontier_global_oldcode_oldreports_unchanged':True}\nout.write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\\n')\nprint(result['whole_source_conclusion'],result['reduced_support_obstruction_if_any'],flush=True)\nprint('PASS explicit identities',data['seconds'],data['maximum_RSS_KiB'],flush=True)\n",
