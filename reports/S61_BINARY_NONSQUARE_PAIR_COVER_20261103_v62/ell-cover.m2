R=QQ[a,e,d,z];F=500*a+90*e^2+3*e-24;B=(50*a+18*e^2-9*e-2)*d+60*e-40;C=100*a+18*e^2-9*e-2;
I=ideal(-400/243*a^2*d^2 - 14/9*a*e^2*d^2 - 32/27*a*e*d^2 - 520/81*a*e*d + 28/15*e^3*d + 64/45*e^2*d + 272/27*e^2 - 112/135*e*d - 256/405*d - 1088/243,-100/27*a^2*e*d^2 + 80/9*a*e^2*d - 40/27*a*e*d - 160/81*a*d - 16/3*e^3 + 16/9*e^2 + 64/27*e - 64/81,800/243*a^2*d^2 - 4/3*a*e^2*d^2 - 16/27*a*e*d^2 - 1360/81*a*e*d + 8/5*e^3*d + 32/45*e^2*d + 416/27*e^2 - 32/45*e*d - 128/405*d - 1664/243,100/27*a^2*e*d^2 - 20000/243*a^2*d - 640/27*a*e^2*d + 920/81*a*e*d + 8000/81*a*e + 800/243*a*d + 6400/81*a + 208/9*e^3 + 16/27*e^2 - 832/81*e - 64/243,-8000/243*a^2*d - 160/27*a*e^2*d + 80/27*a*e*d + 3200/81*a*e + 160/243*a*d + 6400/243*a + 64/9*e^3 + 32/27*e^2 - 256/81*e - 128/243,z*a*F*B*C-1);
