  "executed_source_bytes": "from pathlib import Path\nimport json, hashlib, time, resource\nimport sympy as sp\nresource.setrlimit(resource.RLIMIT_AS,(512*1024*1024,512*1024*1024))\nstarted=time.monotonic()\nrepo=Path('/workspace/poisson-p4')\njobp=repo/'research/classification/jobs/plane_zero_symbol_t36_actual_curve.json'\njob=json.loads(jobp.read_text())\nfor r in job['exact_inputs_and_hashes']:\n assert hashlib.sha256((repo/r['path']).read_bytes()).hexdigest()==r['sha256'],r['path']\nsource=json.loads((repo/job['exact_inputs_and_hashes'][0]['path']).read_text())\nassert source['all_passed'] and source['exact_projective_Jacobi_checked']\neps=sp.Symbol('epsilon',nonzero=True)\nold=sp.symbols('x0:5'); x=sp.symbols('A B C u v'); A,B,C,u,v=x\nloc={str(q):q for q in old}\nloc.update({'p0':eps,'t0':3/eps,'t1':3/eps,'t2':sp.Integer(1),'t3':sp.Integer(1)})\nP=sp.zeros(5)\nfor key,value in source['homogeneous_bivector'].items():\n i,j=map(int,key.split(','));P[i,j]=sp.sympify(value,locals=loc);P[j,i]=-P[i,j]\nM=sp.eye(5);M[0,3]=M[0,4]=1/eps\nM[1,3]=M[2,3]=-5/eps;M[1,4]=M[2,4]=5/eps\nN=sp.eye(5);N[0,3]=N[0,4]=-1/eps\nN[1,3]=N[2,3]=5/eps;N[1,4]=N[2,4]=-5/eps\nassert M.det()==1 and M*N==sp.eye(5) and N*M==sp.eye(5)\nsubs=dict(zip(old,N*sp.Matrix(x)))\nQ=M*P.subs(subs,simultaneous=True)*M.T\nQ=Q.applyfunc(sp.expand)\nR=sp.zeros(5);L=sp.zeros(5)\nrloc={str(q):q for q in x}\nfor key,value in job['expected_endpoint_brackets'].items():\n i,j=[list(map(str,x)).index(k) for k in key.split(',')]\n R[i,j]=sp.sympify(value,locals=rloc);R[j,i]=-R[i,j]\nfor key,value in job['expected_epsilon_coefficient'].items():\n i,j=[list(map(str,x)).index(k) for k in key.split(',')]\n L[i,j]=sp.sympify(value,locals=rloc);L[j,i]=-L[i,j]\nfull150=[]\nfor i in range(5):\n for j in range(i+1,5):\n  assert sp.expand(Q[i,j]-R[i,j]-eps*L[i,j])==0,(i,j)\n  poly=sp.Poly(Q[i,j],x)\n  for a in range(5):\n   for b in range(a,5):\n    mon=x[a]*x[b]\n    coeff=sp.expand(poly.coeff_monomial(mon))\n    assert sp.Poly(coeff,eps).degree()<=1\n    full150.append({'pair':[i,j],'monomial_pair':[a,b],'coefficient':str(coeff)})\nassert len(full150)==150\n# Both raw inverse identities; no Euler or scale correction.\nback=N*Q.subs(dict(zip(x,M*sp.Matrix(old))),simultaneous=True)*N.T\nassert all(sp.expand(back[i,j]-P[i,j])==0 for i in range(5) for j in range(i+1,5))\ndef signed_pf(T,xx):\n result=0\n for omit in range(5):\n  a,b,c,d=[i for i in range(5) if i!=omit]\n  pf=T[a,b]*T[c,d]-T[a,c]*T[b,d]+T[a,d]*T[b,c]\n  result+=(-1)**omit*xx[omit]*pf\n return sp.expand(result)\nF=signed_pf(R,x)\nFexpected=sp.sympify(job['expected_signed_endpoint_F'],locals=rloc)\nassert sp.expand(F-Fexpected)==0\nFp=sp.Poly(F,x)\n# Exhaust all 126 degree-five coefficient positions, including literal zeros.\nmon5=[]\ndef exponents(d,n,prefix=()):\n if n==1:yield prefix+(d,);return\n for k in range(d+1):yield from exponents(d-k,n-1,prefix+(k,))\nfor ex in exponents(5,5):\n mon5.append({'monomial':list(ex),'coefficient':str(Fp.coeff_monomial(ex))})\nassert len(mon5)==126\nFwhole=signed_pf(Q,x)\nFsource=signed_pf(P,old)\nassert sp.expand(Fwhole-Fsource.subs(subs,simultaneous=True))==0\n# Primitive polynomial linear in A,B,C: gcd(u^4,v^4)=1 suffices.\nassert sp.diff(F,B)==3*u**4/5 and sp.diff(F,C)==-3*v**4/5\nassert sp.gcd(sp.diff(F,B),sp.diff(F,C))==1\n# Entire normal-weight-zero symbol vanishes, and only weight one remains.\nfor i in range(5):\n for j in range(i+1,5):\n  for ex,co in sp.Poly(R[i,j],x).terms():\n   if co==0:continue\n   normal_degree=ex[3]+ex[4]\n   expected_degree=(1 if j<3 else (2 if i<3 else 3))\n   assert normal_degree==expected_degree,(i,j,ex,co)\nresult={'task_id':job['task_id'],'all_exact_checks_passed':True,'source_component':'T36 true completed source','direction':job['actual_coordinate_map']['direction'],'parameters':job['prescribed_source_parameters'],'matrix':[[str(a) for a in M.row(i)] for i in range(5)],'inverse_matrix':[[str(a) for a in N.row(i)] for i in range(5)],'determinant':'1','both_matrix_products_identity':True,'raw_Euler_gauge':'0','tensor_scale':'1','all150_forward_coefficients':full150,'all150_inverse_coefficients_match_source':True,'all_Laurent_poles_cancel':True,'full_family_degree_epsilon':1,'endpoint_brackets':{str(i)+','+str(j):str(sp.expand(R[i,j])) for i in range(5) for j in range(i+1,5)},'endpoint_signed_F':str(F),'all126_endpoint_signed_F_coefficients':mon5,'whole_family_Pfaffian_covariance':True,'irreducibility_certificate':'F is primitive linear in (A,B,C) over C[u,v]; its B and C coefficients are 3*u^4/5 and -3*v^4/5 with gcd1, hence absolute irreducibility by Gauss.','endpoint_zero_symbol_full_source':True,'original_T36_allJacobi_reused':True,'new_Jacobi_or_ambient_operator':False,'scope':'Exact actual curve and endpoint. Whole39 T36 containment additionally uses the accepted entire single-actual-orbit theorem and closedness.','input_bindings':job['exact_inputs_and_hashes'],'job_sha256':hashlib.sha256(jobp.read_bytes()).hexdigest(),'seconds':time.monotonic()-started,'maximum_RSS_KiB':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}\ncode=Path(__file__).read_text();result['executed_source_bytes']=code;result['executed_source_sha256']=hashlib.sha256(code.encode()).hexdigest()\nout=repo/'reports/CLASSIFICATION_PLANE_ZERO_SYMBOL_T36_ACTUAL_CURVE_20261108.json'\nwith out.open('x') as f:json.dump(result,f,ensure_ascii=False,indent=2);f.write('\\n')\nprint(json.dumps({'all_exact_checks_passed':True,'full150':len(full150),'full126':len(mon5),'seconds':result['seconds'],'maximum_RSS_KiB':result['maximum_RSS_KiB'],'report':str(out.relative_to(repo)),'sha256':hashlib.sha256(out.read_bytes()).hexdigest()}))\n",
