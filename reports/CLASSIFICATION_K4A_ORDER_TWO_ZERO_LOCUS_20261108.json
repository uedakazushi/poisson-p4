  "inline_source": "from pathlib import Path\nimport json,hashlib,time,resource,itertools\nimport sympy as s\nfrom sympy.polys.matrices import DomainMatrix\nbegun=time.monotonic();resource.setrlimit(resource.RLIMIT_CPU,(80,81));resource.setrlimit(resource.RLIMIT_AS,(2048*1024**2,)*2)\nsource=Path(\"reports/CLASSIFICATION_K4A_COMPLETE_TORUS_SLICE_20261108.json\");graph=json.load(source.open());old=json.load(open(\"reports/CLASSIFICATION_K4A_CANONICAL_FULL_AMBIENT_20261108.json\"));xx=s.symbols(\"c a b u v\");P=s.zeros(5)\nfor key,value in graph[\"graph_coefficients_sparse\"].items():\n i,j=map(int,key.split(\",\"));data=old[\"full_original_coefficient_order\"][i];a,b=data[\"pair\"];P[a,b]+=s.Rational(value)*174**j*s.prod(z**e for z,e in zip(xx,data[\"exponent\"]))\nfor i,j in itertools.combinations(range(5),2):P[i,j]=s.expand(P[i,j]);P[j,i]=-P[i,j]\nassert all(z.q==1 for i,j in itertools.combinations(range(5),2)for z in s.Poly(P[i,j],*xx).coeffs())\nmon_pairs=list(itertools.combinations_with_replacement(range(5),2));mons=[xx[i]*xx[j]for i,j in mon_pairs];rows=[];polys=[]\nfor i,j,k in itertools.combinations(range(5),3):\n cubic=s.expand(xx[i]*P[j,k]-xx[j]*P[i,k]+xx[k]*P[i,j])\n for ell in range(5):rows.append({\"triple\":[i,j,k],\"derivative\":ell});polys.append(s.diff(cubic,xx[ell]))\nA=s.Matrix([[s.Poly(z,*xx).coeff_monomial(m)for m in mons]for z in polys]);rr,piv=DomainMatrix.from_Matrix(A).convert_to(s.QQ).rref();rr=rr.to_Matrix();piv=list(piv);rank=len(piv);free=[j for j in range(15)if j not in piv];K=s.zeros(15,len(free))\nfor k,j in enumerate(free):\n K[j,k]=1\n for i,p in enumerate(piv):K[p,k]=-rr[i,j]\nassert A*K==s.zeros(50,len(free)) and K[free,:]==s.eye(len(free))\nindrows=list(DomainMatrix.from_Matrix(A[:,piv].T).convert_to(s.QQ).rref()[1]);det=DomainMatrix.from_Matrix(A.extract(indrows,piv)).convert_to(s.QQ).det();assert det\nno_point=(K.cols==0);unique=None;Veronese_matrix=None\nif K.cols==1:\n Z=s.zeros(5)\n for (i,j),z in zip(mon_pairs,K[:,0]):Z[i,j]=Z[j,i]=z\n Veronese_matrix=[[str(z)for z in row]for row in Z.tolist()]\n rankZ=len(DomainMatrix.from_Matrix(Z).convert_to(s.QQ).rref()[1])\n if rankZ==1:\n  col=next(j for j in range(5)if any(Z[:,j]));q=Z[:,col];normal=next(z for z in q if z);q=q/normal\n  assert A*s.Matrix([q[i]*q[j]for i,j in mon_pairs])==s.zeros(50,1);unique=list(map(str,q))\n else:no_point=True\njob=json.load(open(\"research/classification/jobs/k4a_order_two_zero_locus.json\"))\npaths=[source,Path(\"reports/CLASSIFICATION_K4A_CANONICAL_FULL_AMBIENT_20261108.json\"),Path(\"reports/CLASSIFICATION_K4A_COMPLETE_TORUS_SLICE_SEPARATE_REVIEW_V2_20261108.json\"),Path(\"research/classification/K4A_ORDER_TWO_ZERO_LOCUS.md\"),Path(\"reports/MPS_SMOOTHING_COMPLETION_20261103_v62/T36.json\"),Path(\"reports/MPS_SMOOTHING_COMPLETION_20261103_v62/T38.json\")]\nresult={\"task_id\":\"E_reduced_nonnormal\",\"all_passed\":True,\"same_dense24_orbit_parameter\":\"integercurvee1, original grapht174; allnonzero parametersPGL-equivalent byprovedtorus\", \"point_coordinate_order\":list(map(str,xx)),\"generic_actual_brackets\":{f\"{i},{j}\":str(P[i,j])for i,j in itertools.combinations(range(5),2)if P[i,j]},\"all50_quadratic_order2_zero_equations\":list(map(str,polys)),\"operator_equation_order\":rows,\"operator_monomial_order\":[list(z)for z in mon_pairs],\"full_operator_shape\":list(A.shape),\"full_operator_sparse\":{f\"{i},{j}\":str(A[i,j])for i,j in A.todok()},\"rank_QQ\":rank,\"kernel_shape\":list(K.shape),\"full_kernel_sparse\":{f\"{i},{j}\":str(K[i,j])for i,j in K.todok()},\"fullkernel_identity_and_independence\":True,\"independent_columns\":piv,\"independent_rows\":indrows,\"nonzero_minor_determinant\":str(det),\"Veronese_symmetric_matrix\":Veronese_matrix,\"order2_zero_point_proved_absent\":no_point,\"unique_order2_zero_point\":unique,\"higher_kernel_rank1_Veronese_intersection_not_solved\":K.cols>1,\"whole_closed_T36_T38_excluded_if_no_point\":no_point,\"T37_not_excluded\":True,\"new_component_count\":0,\"input_sha256\":{str(p):hashlib.sha256(p.read_bytes()).hexdigest()for p in paths},\"inline_source\":job[\"inline_source\"],\"seconds\":time.monotonic()-begun}\no=Path(\"reports/CLASSIFICATION_K4A_ORDER_TWO_ZERO_LOCUS_20261108.json\")\nwith o.open(\"x\")as f:json.dump(result,f,indent=2);f.write(\"\\n\")\nprint(json.dumps({\"all_passed\":True,\"rank\":rank,\"kernel\":K.cols,\"absent\":no_point,\"unique\":unique,\"seconds\":result[\"seconds\"]}))\n",
