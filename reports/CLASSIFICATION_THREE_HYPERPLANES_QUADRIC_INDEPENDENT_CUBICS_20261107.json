    "reports/CLASSIFICATION_THREE_HYPERPLANES_QUADRIC_INDEPENDENT_20261107.json": "5835051c4085640dbb07dca8cb340c76bf31c0d8ff1f65d746553a58236d2fc8",
    "reports/CLASSIFICATION_THREE_HYPERPLANES_QUADRIC_INDEPENDENT_NORMALS_20261107.json": "af7affc35c378b7ef5ab23aab09250dbf8390e978341a4ba663976649de4e9e3",
