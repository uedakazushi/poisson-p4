  "independent_source": "from pathlib import Path\nimport hashlib,itertools,json,resource,signal,sys,time\nimport sympy as s\nROOT=Path.cwd();sys.path.insert(0,str(ROOT/'code'))\nfrom classification_rank3_mixed_component_review import COLUMNS,jacobi\nOUT=ROOT/'reports/CLASSIFICATION_CONSTANT_MODULAR_TRIPLE_GA9_FULL_FAMILY_ROOT_REVIEW_20261108.json'\njob=json.loads((ROOT/'research/classification/jobs/constant_modular_triple_ga9_full_family_root_review.json').read_text())\nassert not OUT.exists()\nfor f in job['exact_inputs_and_hashes']:\n assert hashlib.sha256((ROOT/f['path']).read_bytes()).hexdigest()==f['sha256'],f['path']\nstart=time.monotonic();signal.alarm(60);resource.setrlimit(resource.RLIMIT_AS,(1024**3,1024**3))\ne=s.symbols('e');T,x,y,F=src=s.symbols('T x y F');t,r=s.symbols('t r');dst=(t,x,y,r)\nH=x**3+3*x*y-s.Rational(3,2)*y;k=x*y/3+y*y/2-x**4/12\nA=e/12;B=e*(15-e)/72;M=A*x*x*y+B*y*y\nchange=s.Matrix([(1-e*x/3)*T-x*F/3-k+M,x,y,F+e*T-H]);J=change.jacobian(src)\nassert s.expand(J.det())==1\ninvT=t+x*(r+H)/3+k-M;invF=r+H-e*invT;inv=s.Matrix([invT,x,y,invF])\nassert (change.subs(dict(zip(src,inv)),simultaneous=True)-s.Matrix(dst)).applyfunc(s.expand)==s.zeros(4,1)\nassert (inv.subs(dict(zip(dst,change)),simultaneous=True)-s.Matrix(src)).applyfunc(s.expand)==s.zeros(4,1)\nbase=s.zeros(4);base[0,3]=F;base[3,0]=-F;base[1,2]=1;base[2,1]=-1\nphysical=(J*base*J.T).subs(dict(zip(src,inv)),simultaneous=True).applyfunc(s.expand)\nformula=[x/3+(1-2*B)*y-A*x*x,(-1+2*A)*x*y+y/6-r/3,-e*t+(1-e/3)*x*r+(-3+3*e/4+e*e/8-e**3/72)*y*y+5*e*x*y/12-5*y/4+r/2,1,-3*x+s.Rational(3,2),3*x*x+3*y]\nfor ij,f in zip(itertools.combinations(range(4),2),formula):assert s.expand(physical[ij]-f)==0\ndiv=s.Matrix([s.expand(sum(s.diff(physical[i,j],dst[i])for i in range(4)))for j in range(4)])\nassert div==s.Matrix([-1+e*x/3,0,0,-e])\npf=s.expand(physical[0,1]*physical[2,3]-physical[0,2]*physical[1,3]+physical[0,3]*physical[1,2]);assert s.expand(pf-invF)==0\nassert s.Poly(pf,t,x,y,r).coeff_monomial(t)==-e\nassert s.Poly(pf,t,x,y,r).coeff_monomial(x**4)==-e/4\nassert pf.subs({t:0,x:0,y:0,r:1})==1\nh=s.symbols('h');Y=(h,t,x,y,r);raw=s.zeros(5)\nfor i,j in itertools.combinations(range(4),2):\n poly=s.Poly(physical[i,j],*dst);assert poly.total_degree()<=2\n f=sum(co*h**(2-sum(mon))*s.prod(q**v for q,v in zip(dst,mon))for mon,co in poly.terms());raw[i+1,j+1]=s.expand(f);raw[j+1,i+1]=-raw[i+1,j+1]\nZ=s.Matrix([s.expand(sum(s.diff(raw[i,j],Y[i])for i in range(5)))for j in range(5)])\nE=s.Matrix(Y);P=(raw-(E*Z.T-Z*E.T)/5).applyfunc(s.expand)\ndef coeffs(Q):\n polys={ij:s.Poly(Q[ij],*Y)for ij in itertools.combinations(range(5),2)}\n return [polys[ij].coeff_monomial(mon)for ij,mon in COLUMNS]\ndef sparse(Q):return {ij:{mon:co for mon,co in s.Poly(Q[ij],*Y).terms()if co}for ij in itertools.combinations(range(5),2)if Q[ij]!=0}\ncs=coeffs(P);assert len(cs)==150\nfor f in cs:s.Poly(f,e)\nassert all(s.expand(q)==0 for q in jacobi(sparse(P)))\nassert all(s.expand(q)==0 for v in jacobi(sparse(P),raw=True).values()for q in v.values())\nD=0\nfor i in range(5):\n j,k0,l,m=[v for v in range(5)if v!=i];D+=(-1)**i*Y[i]*(P[j,k0]*P[l,m]-P[j,l]*P[k0,m]+P[j,m]*P[k0,l])\nD=s.expand(D)\npfh=sum(co*h**(4-sum(mon))*s.prod(q**v for q,v in zip(dst,mon))for mon,co in s.Poly(pf,*dst).terms())\nassert s.expand(D-h*pfh)==0\nassert s.expand(D.subs(e,0)-h*h*(x**3+3*h*x*y-s.Rational(3,2)*h*h*y+h*h*r))==0\nXg,Yg,Zg,Wg,u=s.symbols('Xg Yg Zg Wg u');mapg=s.Matrix([t-r/e,e*x/3,-r/e,y]);Mg=mapg.jacobian(dst)\nassert s.factor(Mg.det())==s.Rational(1,3)\ninvg=s.Matrix([Xg-Zg,3*Yg/e,Wg,-e*Zg]);assert (mapg.subs(dict(zip(dst,invg)),simultaneous=True)-s.Matrix([Xg,Yg,Zg,Wg])).applyfunc(s.expand)==s.zeros(4,1)\nassert (invg.subs(dict(zip((Xg,Yg,Zg,Wg),mapg)),simultaneous=True)-s.Matrix(dst)).applyfunc(s.expand)==s.zeros(4,1)\nassert (Mg*div).subs(dict(zip(dst,invg)),simultaneous=True).applyfunc(s.expand)==s.Matrix([Yg,0,1,0])\nnewpf=s.expand((pf/3).subs(dict(zip(dst,invg)),simultaneous=True).subs(Xg,u+Yg*Zg))\nassert s.diff(newpf,u)==-e/3 and not newpf.has(Zg)\norder=sorted({tuple(v.count(i)for i in range(5))for v in itertools.combinations_with_replacement(range(5),5)},reverse=True)\nresult=dict(task_id='E_multiple_hyperplane',status='independent_full_universal_actual_family_reconstruction_PASS',all_passed=True,new_point_profile_normal_or_jet=False,auxiliary_map=list(map(str,change)),auxiliary_inverse=list(map(str,inv)),auxiliary_jacobian_determinant='1',all_six_physical=list(map(str,formula)),all150_canonical=list(map(str,cs)),coefficient_order=[dict(pair=list(ij),exponent=list(mon))for ij,mon in COLUMNS],all350_original_Jacobi=['0']*350,strict_Jacobi=True,full126_order=[list(mon)for mon in order],full126_actual_D=list(map(str,[s.Poly(D,*Y).coeff_monomial(mon)for mon in order])),full_signed_affine_Pf=str(pf),e0_actual_D='h**2*(x**3+3*h*x*y-3*h**2*y/2+h**2*r)',e0_all_six=list(map(str,[q.subs(e,0)if hasattr(q,'subs')else q for q in formula])),divergence=list(map(str,div)),Ga9_actual_affine_frame=list(map(str,mapg)),Ga9_inverse=list(map(str,invg)),Ga9_determinant='1/3',Ga9_modular_standard='Yg*d_Xg+d_Zg',Ga9_signed_Pf_in_uYgWg=str(newpf),Ga9_Phi_u='e/3',generic_quartic_irreducible='coefficient of t is -e unit; primitive linear t polynomial and x4 coefficient -e/4',whole_source_membership='pure wholeGa9constant theorem and full4source oneorbit bridge audited separately; no multipleH/PfQ0 theorem used on eunit simpleH',bindings=job['exact_inputs_and_hashes'],seconds=time.monotonic()-start,maximum_RSS_KiB=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,independent_source=Path(__file__).read_text())\nsignal.alarm(0)\nwith OUT.open('x')as f:json.dump(result,f,ensure_ascii=False,indent=2);f.write('\\n')\nprint(json.dumps({k:result[k]for k in ['status','seconds','maximum_RSS_KiB','Ga9_Phi_u']}))\n"
}
