(ell)*x0*x2+(-ell^(-1))*x1^2))-x3*(-(((-ell^2+2*ell^(-3))/5)*x4*x1+(-ell^(-2))*x2*x3+(1)*x0^2))+x4*((((-ell^2+2*ell^(-3))/5)*x1*x3+(-ell^(-2))*x4*x0+(1)*x2^2)),x2*((((2*ell^2+ell^(-3))/5)*x3*x4+(ell)*x0*x2+(-ell^(-1))*x1^2))-x3*((((-ell^2+2*ell^(-3))/5)*x2*x4+(-ell^(-2))*x0*x1+(1)*x3^2))+x4*((((2*ell^2+ell^(-3))/5)*x2*x3+(ell)*x4*x1+(-ell^(-1))*x0^2)));\nJ=saturate J;\nC=res(coker gens J);\nassert(codim J==2);\nassert(degree(R/J)==5);\nassert(numgens J==5);\nassert(rank C_0==1 and rank C_1==5 and rank C_2==5 and rank C_3==1);\nassert(degrees C_1=={{3},{3},{3},{3},{3}});\nassert(degrees C_2=={{4},{4},{4},{4},{4}});\nassert(degrees C_3=={{5}});\nassert(rank(C.dd_1*C.dd_2)==0 and rank(C.dd_2*C.dd_3)==0);\nassert(codim minors(4,C.dd_2)>=2);\nassert(codim minors(1,C.dd_3)>=3);\nbad=saturate(J+minors(2,jacobian gens J));\nassert(bad==ideal(1_R));\n<<\"GENERIC_FIELD_QQ_ell_PASS\"<<endl;\n<<\"ZERO_SURFACE_BETTI \"<<toString betti C<<endl;\n<<\"IDEAL_RESOLUTION 0->R(-5)->R(-4)^5->R(-3)^5->I->0\"<<endl;\n<<\"BUCHSBAUM_EISENBUD_GRADES_PASS\"<<endl;\n<<\"PROJECTIVE_SMOOTHNESS_PASS\"<<endl;\n<<\"ZERO_CUBICS \"<<toString gens J<<endl;\n<<\"D2 \"<<toString C.dd_2<<endl;\n<<\"D3 \"<<toString C.dd_3<<endl;\nexit 0;\n",
