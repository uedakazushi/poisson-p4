R=QQ[s0,s1,s2,s3,s4,s5,s6,s7,s8,s9];
I=ideal(-2*s0^2*s1*s2*s7/125,-6*s0^3*s2*s7/125 - 4*s0*s1*s2*s7/25,6*s0^3*s2*s7/125 + 2*s0*s1*s2*s7/25,-3*s0^2/40 + 3*s0*s3/20 - s1/10 + s5/2,-3*s0^2*s7/40 - 3*s0*s3*s7/20 + 3*s0*s4/10 - s1*s7/10 - s5*s7/2 + s6,-s0^2*s2*s7/25,-s7^2 + s8,-s7*s8/2 + 3*s9/2,2*s1*s2*s7/5,s0*s1*s2*s7/25 + s0*s2*s5*s7/5,2*s0*s2*s6*s7/5,s0^2*s2*s7/50 + s0*s2*s3*s7/5,2*s0*s2*s4*s7/5,s0*s2*s7^2/5,2*s0*s2*s7*s8/5,3*s0*s2*s7*s9/5,-s0*s2*s7/5 - 2*s1*s2/5,-s0*s2/5,s0*s1*s2*s7/25 - s0*s2*s5*s7/5,s0^2*s2*s7/50 - s0*s2*s3*s7/5,-s0*s2*s7/5,-2*s0*s2*s7^2/5,-s0*s2*s7*s8/5,-s0*s7/8 + s1 - s3*s7/4 + s4/2,-9*s0/8 + s3/4 - 2*s7,-8*s0^2*s1*s2*s7/125,s0*s1/8 + s0*s5/8 - s1*s3/4 - s3*s5/4,s0*s1*s7/8 - s0*s5*s7/8 + s0*s6/4 + s1*s3*s7/4 - s1*s4/2 - s3*s5*s7/4 - s3*s6/2 + s4*s5/2,-8*s0^3*s2*s7/125 - 4*s0*s1*s2*s7/25,9*s0^2/80 - s0*s3/10 + 2*s1/5 - s3^2/4,9*s0^2*s7/80 + s0*s3*s7/10 - s0*s4/5 + 2*s1*s7/5 - s3^2*s7/4,-s3*s7/2 + s4/2,-s0*s7^2/4 + s0*s8/4 - s3*s7^2/2 - s3*s8/2 + s4*s7,-s0*s7*s8/8 + 3*s0*s9/8 - s3*s7*s8/4 - 3*s3*s9/4 + s4*s8/2,s0*s1*s2*s7/8 + s1*s2*s3*s7/4 - s1*s2*s4/2,9*s0^2*s2*s7/200 + s0*s2*s3*s7/4 - s0*s2*s4/2 + 2*s1*s2*s7/5,2*s0^2*s1*s2*s7/125 + 2*s0^2*s2*s5*s7/25,4*s0^2*s2*s6*s7/25,3*s0*s2*s7/40 - s2*s3*s7/4 + s2*s4/2,s0^3*s2*s7/125 + 2*s0^2*s2*s3*s7/25,4*s0^2*s2*s4*s7/25,2*s0^2*s2*s7^2/25,4*s0^2*s2*s7*s8/25,6*s0^2*s2*s7*s9/25,-2*s0^2*s2*s7/25 - s0*s1*s2/8 + s1*s2*s3/4,-s0^2*s2/8 + s0*s2*s3/4 - 2*s1*s2/5,2*s0^2*s1*s2*s7/125 - 2*s0^2*s2*s5*s7/25,-3*s0*s2/40 - s2*s3/4,s0^3*s2*s7/125 - 2*s0^2*s2*s3*s7/25,-2*s0^2*s2*s7/25,-4*s0^2*s2*s7^2/25,-2*s0^2*s2*s7*s8/25,2*s0^2*s2*s7/25 - s1*s2*s7/10 - s2*s5*s7/2 + s2*s6,3*s0*s2*s7/20 - s2*s3*s7/2 + s2*s4,-s0^3*s2*s7/125 - 2*s0^2*s2*s3*s7/25 - s0*s1*s2*s7/25 - s0*s2*s5*s7/5 - s2*s7^2 + s2*s8,-4*s0^2*s2*s4*s7/25 - 2*s0*s2*s6*s7/5 - s2*s7*s8 + 3*s2*s9,2*s0*s2*s7/5 + s1*s2/10 - s2*s5/2,s0*s2/20 - s2*s3/2,-s0^3*s2*s7/125 + 2*s0^2*s2*s3*s7/25 - s0*s1*s2*s7/25 + s0*s2*s5*s7/5 + s2*s7^2 - s2*s8,3*s0^2/80 + s0*s3/20 + 3*s1/10 - s3^2/4 + s5/2,3*s0^2*s7/160 - s0*s3*s7/40 + s0*s4/20 + 3*s1*s7/20 - s3^2*s7/8 - s5*s7/4 + s6/2,-2*s0*s2 - 3*s2*s7,-2*s0^3*s2^2*s7/25 - 2*s0*s1*s2^2*s7/5,s0^2*s2/8 - s0*s2*s3/4 + 11*s1*s2/10 + s2*s5/2,s0^2*s2*s7/8 + s0*s2*s3*s7/4 - s0*s2*s4/2 + 11*s1*s2*s7/10 - s2*s5*s7/2 + s2*s6,-s0^2*s2^2*s7/25,3*s0*s2/10 + s2*s3,3*s0*s2*s7/10 - s2*s3*s7 + 2*s2*s4,-s2*s7^2 + s2*s8,-s2*s7*s8/2 + 3*s2*s9/2);
J=ideal(s0 - 2*s3/9 + 16*s7/9,s1 + 2*s3*s7/9 + 2*s7^2/9,-s3*s7 + s4,-10*s3*s7/27 + s5 - 10*s7^2/27,s6,-s7^2 + s8,-s7^3/3 + s9,s2*s3 + s2*s7,s2*s3 - s2*s7,s3^2 - s7^2,s3^3 + 3*s3^2*s7 + 3*s3*s7^2 + s7^3);
assert(I==J);
S=QQ[w,u,v];
K=ideal(w*u,w*v,u*v,u^3);
assert(K==intersect(ideal(u,v),ideal(u,w),ideal(w,v,u^3)));
assert(dim(S/K)==1);
assert(degree(S/K)==2);
print "CB_B18_FULL_CRITICAL_GERM_PASS";
exit 0;
