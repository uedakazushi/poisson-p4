  "scope": "ONEtwoENTIREequivariantIFTgraphs, priorbounds4/3/all350literaldegrees8/6; noadaptivejet/profile/point/minorseries. Bothreducedsupportoutcomescertifiedbyfullpolynomialgraphs andpure\u00e9taleproductproof. WholeA10sourcesreturnedbyclosedorbitbridge. Componentnames/newcountseparate.",
  "inline_source": "from pathlib import Path\nimport ast,hashlib,importlib.util,json,math,resource,signal,time\nimport sympy as s\nROOT=Path.cwd();JOB=ROOT/'research/classification/jobs/plane_m2_hf_complete_torus_slices_v2.json';job=json.loads(JOB.read_text())\nfor item in job['exact_inputs_and_hashes']:assert hashlib.sha256((ROOT/item['path']).read_bytes()).hexdigest()==item['sha256'],item['path']\nfrozen=json.loads((ROOT/'research/classification/inputs/plane_m2_hf_complete_torus_slices_caller_v2_20261108.json').read_text());assert hashlib.sha256(frozen['inline_source'].encode()).hexdigest()==frozen['inline_source_sha256'];helper=ROOT/'code/classification_plane_smooth_cubic_weights.py';spec=importlib.util.spec_from_file_location('unchanged_full_Jacobi_polynomial_arithmetic',helper);H=importlib.util.module_from_spec(spec);spec.loader.exec_module(H)\nOUT=ROOT/'reports/CLASSIFICATION_PLANE_M2_HF_COMPLETE_TORUS_SLICES_V2_20261108.json';assert not OUT.exists();started=time.monotonic();records=[]\ndef timeout(signum,frame):\n partial=ROOT/'reports/CLASSIFICATION_PLANE_M2_HF_COMPLETE_TORUS_SLICES_V2_PARTIAL_20261108.json'\n if not partial.exists():partial.write_text(json.dumps({'task_id':'E_reduced_nonnormal','all_exact_arithmetic_passed':False,'failure':'180secondfinitebudget','completed_cases':records,'inline_source':frozen['inline_source'],'seconds':time.monotonic()-started},indent=2)+'\\n')\n raise TimeoutError('ONEtwoCOMPLETEequivariantgraphsbudget180s')\nsignal.signal(signal.SIGALRM,timeout);signal.alarm(180);resource.setrlimit(resource.RLIMIT_AS,(3072*1024**2,)*2)\nsource=ROOT/'reports/CLASSIFICATION_PLANE_M2_HF_TWO_FULL_FAMILY_AMBIENT_20261108.json';packet=json.loads(source.read_text());x=s.Matrix(s.symbols('a b c u v'));T=s.Symbol('t');mp={str(v):v for v in x};columns=packet['full_original_coefficient_order'];equations=packet['full_original_equation_order'];mons=H.monomials(5,4);assert len(columns)==150 and len(equations)==350\nassert equations==[{'quad':list(q),'exponent':list(e)}for q in H.QUADS for e in mons]\ndef decode(saved):\n A=s.zeros(*saved['shape'])\n for key,value in saved['entries'].items():i,j=map(int,key.split(','));A[i,j]=s.Rational(value)\n return A\ndef matrix_from_vector(vector):\n P=s.zeros(5)\n for col,value in zip(columns,vector):\n  if value:\n   i,j=col['pair'];P[i,j]+=value*s.prod(v**e for v,e in zip(x,col['exponent']))\n for i,j in H.PAIRS:P[j,i]=-P[i,j]\n return P\ndef jac_vector(vector):\n P=matrix_from_vector(vector);J=H.projective(H.bilinear(P,P,x),x);cache={q:s.Poly(s.expand(J[q]/2),*x)for q in H.QUADS};return s.Matrix([cache[tuple(row['quad'])].coeff_monomial(row['exponent'])for row in equations])\ndef enc_vector(vector):return{str(i):str(value)for i,value in enumerate(vector)if value}\nfor case,maxdegree in zip(packet['cases'],[4,3]):\n assert case['normal_quotient_character_dimensions_from_same_matrices']=={'-2':1};D=decode(case['complete_sparse_matrices']['D350x150']);M=decode(case['complete_sparse_matrices']['Euler_GL_scalar150x51']);K=decode(case['certificates']['D350x150']['complete_kernel_sparse']);wc=case['all150_input_weights'];wr=case['all350_equation_weights'];assert maxdegree==(-min(wc))//2;d=case['certificates']['D350x150'];g=case['certificates']['Euler_GL_scalar150x51'];assert d['rank']==101 and g['rank']==48\n U=d['minor_columns'];R=d['minor_rows'];block=D.extract(R,U);det=block.det(method='domain-ge');assert det==s.Rational(d['minor_determinant'])and det;BI=block.inv(method='DM');G=M[:,g['minor_columns']];S=g['minor_rows'];GB=G[S,:];gdet=GB.det(method='domain-ge');assert gdet==s.Rational(g['minor_determinant'])and gdet;GI=GB.inv(method='DM');normal=None\n for j in range(K.cols):\n  if wc[d['free_columns'][j]]!=-2:continue\n  candidate=K[:,j];residual=candidate-G*GI*candidate[S,:]\n  if any(residual):normal=(j,candidate,residual);break\n assert normal is not None;normal_index,N,residual=normal;assert D*N==s.zeros(350,1)and all(wc[i]==-2 for i,value in enumerate(N)if value);at=next(i for i,value in enumerate(residual)if value);functional=s.zeros(1,150);functional[0,at]=1;row=G[at,:]*GI\n for j,i in enumerate(S):functional[0,i]-=row[j]\n functional=functional.applyfunc(s.cancel);value=(functional*N)[0];assert value==residual[at]and value and functional*M==s.zeros(1,51)\n P0=s.zeros(5)\n for key,text in case['complete_actual_integer_brackets'].items():i,j=ast.literal_eval(key);P0[i,j]=s.sympify(text,locals=mp);P0[j,i]=-P0[i,j]\n v0=s.Matrix([s.Poly(P0[tuple(col['pair'])],*x).coeff_monomial(col['exponent'])for col in columns]);assert all(wc[i]==0 for i,value in enumerate(v0)if value)\n graph=v0+T*N;layers=[]\n for degree in range(2,maxdegree+1):\n  current=jac_vector(graph);rhs=s.Matrix([s.expand(current[i]).coeff(T,degree)for i in R]);coeff=(-BI*rhs).applyfunc(s.cancel);layer=s.zeros(150,1)\n  for j,i in enumerate(U):layer[i]=coeff[j]\n  assert all(wc[i]==-2*degree for i,value in enumerate(layer)if value);graph+=T**degree*layer;check=jac_vector(graph)\n  assert all(s.expand(check[i]).coeff(T,d0)==0 for i in R for d0 in range(degree+1));layers.append({'degree':degree,'entire150_layer_sparse':enc_vector(layer),'implicit101_coefficients_sparse':enc_vector(coeff),'whole_weight_forced':-2*degree})\n fullJ=jac_vector(graph);full={}\n for i,expression in enumerate(fullJ):\n  poly=s.Poly(expression,T);assert poly.degree()<=2*maxdegree\n  for monomial,coefficient in poly.terms():\n   degree=monomial[0]\n   if coefficient:assert degree>=2 and wr[i]==-2*degree;full[str(i)+','+str(degree)]=str(coefficient)\n assert all(int(key.split(',')[0])not in R for key in full)\n graph_sparse={str(i)+','+str(degree):str(s.expand(graph[i]).coeff(T,degree))for i in range(150)for degree in range(maxdegree+1)if s.expand(graph[i]).coeff(T,degree)}\n primes={}\n for key,text in graph_sparse.items():\n  i,degree=map(int,key.split(','))\n  if degree:\n   for prime,exponent in s.factorint(s.Rational(text).q).items():primes[int(prime)]=max(primes.get(int(prime),0),(int(exponent)+degree-1)//degree)\n scale=math.prod(prime**exponent for prime,exponent in primes.items());assert scale>=1;integer_parent=matrix_from_vector(graph.subs(T,scale)).applyfunc(s.expand);assert all(value.q==1 for i,j in H.PAIRS for _,value in s.Poly(integer_parent[i,j],*x).terms())\n outcome='smooth_unique24_actual_parent'if not full else'reduced_slice_origin_full23_orbit_component';record={'source':case['source'],'complete_graph_degree_bound':maxdegree,'complete_all350_equation_degree_bound':2*maxdegree,'selected101_equation_rows':R,'selected101_coordinate_columns':U,'existing101_block_determinant_reverified':str(det),'existing48_group_minor_determinant_reverified':str(gdet),'normal_from_existing_kernel_basis_index':normal_index,'full150_normal_sparse':enc_vector(N),'normal_character':-2,'annihilator_of_all51_actual_columns':{str(i):str(functional[0,i])for i in range(150)if functional[0,i]},'normal_non_group_exact_functional_value':str(value),'all_four_or_three_fixed_graph_layers':layers,'graph_coefficient_array_shape':[150,maxdegree+1],'graph_coefficients_sparse':graph_sparse,'all350_full_equation_array_shape':[350,2*maxdegree+1],'all350_full_equation_coefficients_sparse':full,'all101_implicit_equations_identically_zero':True,'all350_full_equations_identically_zero':not bool(full),'full_reduced_slice_support':'A1'if not full else'origin','mathematical_outcome':outcome,'projective_unique_component_dimension':24 if not full else 23,'whole_A10_family_closed_parent_by_dense_orbit_bridge':True,'integer_parameter_rescale_t_equals_scale_times_e':scale,'integer_e1_graph_is_actual_Poisson':not bool(full),'all_integer_e1_graph_brackets':{str((i,j)):str(integer_parent[i,j])for i,j in H.PAIRS},'generic_nonzero_curve_one_dense24_orbit':not bool(full),'known_component_name_or_new_count':'Notidentifiedbythisjob, rootactualrecognition/priorauditseparate.','all150_input_weights':wc,'all350_output_weights':wr}\n records.append(record);print('HFcompletegraph',case['source'],'degree',maxdegree,'full350nonzero',len(full),'outcome',outcome,'integer_t_scale',scale,flush=True)\nresult={'task_id':'E_reduced_nonnormal','all_exact_arithmetic_passed':True,'cases':records,'scope':'ONEtwoENTIREequivariantIFTgraphs, priorbounds4/3/all350literaldegrees8/6; noadaptivejet/profile/point/minorseries. Bothreducedsupportoutcomescertifiedbyfullpolynomialgraphs andpure\u00e9taleproductproof. WholeA10sourcesreturnedbyclosedorbitbridge. Componentnames/newcountseparate.','inline_source':frozen['inline_source'],'inline_source_sha256':frozen['inline_source_sha256'],'input_bindings':job['exact_inputs_and_hashes'],'seconds':time.monotonic()-started,'maximum_RSS_KiB':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss};OUT.write_text(json.dumps(result,indent=2)+'\\n')\n",
